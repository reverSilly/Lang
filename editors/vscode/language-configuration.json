{
  "comments": {
    "blockComment": [
      "!",
      "!"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "!",
      "!"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*!\\s*={3,}",
      "end": "^\\s*!\\s*={3,}"
    }
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
