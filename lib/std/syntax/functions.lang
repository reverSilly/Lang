    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    p_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z   ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;
    b_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;

    w_arg  := #block(^( arena := $#parent(#this).arena ; sym := __arg ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
    p_arg  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_this ; \1 := $#parent(#this).w_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    d_arg  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    al_p   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_arg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    s_bp   := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).p_ast ; \1 := $#parent(#this).al_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    code_s := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_bp ; \1 := $#parent(#this).b_ast ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false) ;
