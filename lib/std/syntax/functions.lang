! ============================================================================ !
! lib/std/syntax/functions.lang — Upward `.sym` Lookup, Calls & Lambdas        !
!                                                                              !
! Loaded by lib/std/syntax/layer1.lang after ops.lang (full Layer 1 active).   !
! Prototype-first: smart-bind (`p_smart_bind`), call-frame execution           !
! (`p_apply_body`), and upward lookup (`fn_lookup_sym` + `p_exec_lookup`) are  !
! written as readable stageable Prototypes; AST builders only emit thin glue.  !
! ============================================================================ !

! --- 1. Pure stageable upward lookup prototype `fn_lookup_sym` --- !
lk_iops := {
    zero_raw8 := $#parent(#this).Z ;
    T_raw     := $#parent(#this).T
} ;

wrap_lk_op := ^(
    $#block(^(
        p_iops := $#parent(#this).lk_iops ;
        arena  := $#parent(#this).arena ;
        p_raw  := $#parent(#this).op_raw ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        sym := iops ; w_i := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_iops ; n_i := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; \0 := $.n_i ; \1 := $.n_f ; t_ai := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        kind := bind ; \0 := $.w_i ; \1 := $.t_ai ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; \0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ;
        \0 := $.s2 ; \1 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.\0) ; #drop(.\1) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ), $.F)
) ;

op_raw := ^(
    cur  := #allocate_val(#parent(#this), $.iops.T_raw) ;
    res  := #allocate_val(#field($.cur, $.sym), $.iops.T_raw) ;
    done := #allocate_val(~($.res.addr == $.iops.zero_raw8), $.iops.T_raw) ;
    (
        env_p := #field($.cur, __fn_env) ;
        (
            .res  = #field($.env_p, $.sym) ;
            .done = true
        ) if ~($.env_p.addr == $.iops.zero_raw8) else (
            .cur = #parent($.cur) ;
            (
                .done = true
            ) if ($.cur.addr == $.iops.zero_raw8) else (
                .res  = #field($.cur, $.sym) ;
                .done = ~($.res.addr == $.iops.zero_raw8)
            )
        ) ;
        #drop(.env_p)
    ) while ~($.done) ;
    $.res
) ;
fn_lookup_sym := #evaluate($.wrap_lk_op) ; #drop(.op_raw) ;

p_exec_lookup := ^(
    __p := #field(#parent(#this), $.__cfg.s) ;
    sym := #deref($.__p) ;
    #drop($.__p) ;
    #break(#evaluate($.__cfg.op))
) ;

! --- 1b. Prototype-first Smart-Bind (`p_smart_bind` + thin AST glue) --- !
sb_iops := {
    pointer_shape := $#parent(#this).c_con.pointer_shape ;
    F             := $#parent(#this).F
} ;

p_sb_raw := ^(
    (
        #branch(
            #bind($.__sb_k, $.__sb_v),
            ^( #drop(.__sb_k) ; #drop(.__sb_v) ; #drop(.__sb_iops) ),
            ^( #bind($.__sb_k, #allocate_val($.__sb_v, $.__sb_iops.F)) ; #drop(.__sb_k) ; #drop(.__sb_v) ; #drop(.__sb_iops) )
        )
    ) if (#shape($.__sb_v) == $.__sb_iops.pointer_shape) else (
        #bind($.__sb_k, #allocate_val($.__sb_v, $.__sb_iops.F)) ;
        #drop(.__sb_k) ; #drop(.__sb_v) ; #drop(.__sb_iops)
    )
) ;

p_smart_bind := $#block(^(
    arena := $#parent(#this).arena ;
    val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
    sym := __sb_iops ; w_i := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
    val := $#parent(#this).sb_iops ; n_i := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
    kind := allocate_val ; \0 := $.n_i ; \1 := $.n_f ; t_ai := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
    kind := bind ; \0 := $.w_i ; \1 := $.t_ai ; s1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
    val := $#parent(#this).p_sb_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
    kind := evaluate ; \0 := $.n_r ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ;
    \0 := $.s1 ; \1 := $.s2 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.\0) ; #drop(.\1) ;
    #break(#evaluate($#parent(#this).c_ast.to_proto))
), $.F) ;

! Thin AST glue: evaluate `sb_rhs` into `__sb_v`, bind `__sb_k := sb_w_key`, #evaluate(p_smart_bind) !
build_smart_bind_ast := ^(
    $#block(^(
        caps    := $#parent(#this).caps ;
        arena   := $#parent(#this).arena ;
        w_key   := $#parent(#this).sb_w_key ;
        rhs_ast := $#parent(#this).sb_rhs ;
        p_sb    := $#parent(#this).env.p_smart_bind ;
        F       := $.caps.constants.\false ;

        n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
        w_v    := #block(^( arena := $#parent(#this).arena ; sym := __sb_v ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
        w_k    := #block(^( arena := $#parent(#this).arena ; sym := __sb_k ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;

        al_v   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).rhs_ast ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        s_v    := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_v ; \1 := $#parent(#this).al_v ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        al_k   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).w_key ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        s_k    := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_k ; \1 := $#parent(#this).al_k ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        v_sb   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).p_sb ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
        ev_sb  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; \0 := $#parent(#this).v_sb ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

        #break($#block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_v ; \1 := $#parent(#this).s_k ; \2 := $#parent(#this).ev_sb ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false))
    ), $.caps.constants.\false)
) ;

! --- 2. Prototype-first Single-Arg Call (`p_apply_body` + thin AST glue) --- !
p_apply_body := ^(
    __p_cf   := #field(#parent(#this), $.__ap_cfg.cf) ;
    __p_ca   := #field(#parent(#this), $.__ap_cfg.ca) ;
    __fn     := #deref($.__p_cf) ;
    __arg    := #deref($.__p_ca) ;
    #drop($.__p_cf) ;
    #drop($.__p_ca) ;
    #drop(.__p_cf) ;
    #drop(.__p_ca) ;
    __fn_env := $.__fn.__env ;
    __code   := $.__fn.__code ;
    #drop(.__fn) ;
    #bind(__sb_v, #allocate_val(#evaluate($.__code), $.__ap_cfg.F)) ;
    #bind(__sb_k, #allocate_val(__fn_ret, $.__ap_cfg.F)) ;
    #evaluate($.__ap_cfg.p_sb) ;
    #break($.__fn_ret)
) ;

build_apply_ast := ^(
    $#block(^(
        caps   := $#parent(#this).caps ;
        arena  := $#parent(#this).arena ;
        cf_sym := $#parent(#this).cf_sym ;
        ca_sym := $#parent(#this).ca_sym ;
        a_fn   := $#parent(#this).a_fn ;
        a_arg  := $#parent(#this).a_arg ;
        env    := $#parent(#this).env ;
        F      := $.caps.constants.\false ;

        n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
        w_cf   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).cf_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
        w_ca   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).ca_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
        w_cfg  := #block(^( arena := $#parent(#this).arena ; sym := __ap_cfg ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;

        ! Step 1: In caller #this, smart-bind callee & arg to hygienic slots !
        sb_w_key := $.w_cf ; sb_rhs := $.a_fn ;
        s_cf := #evaluate($.env.smart_bind) ;
        #drop(.sb_w_key) ; #drop(.sb_rhs) ;
        sb_w_key := $.w_ca ; sb_rhs := $.a_arg ;
        s_ca := #evaluate($.env.smart_bind) ;
        #drop(.sb_w_key) ; #drop(.sb_rhs) ;

        ! Step 2: Enter callee #block, bind __ap_cfg, #evaluate(p_apply_body) !
        cfg_v  := { cf := $#parent(#this).cf_sym ; ca := $#parent(#this).ca_sym ; F := $#parent(#this).F ; p_sb := $#parent(#this).env.p_smart_bind } ;
        n_cfg  := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).cfg_v ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
        al_cfg := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).n_cfg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        b_cfg  := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_cfg ; \1 := $#parent(#this).al_cfg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
        v_body := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).env.p_apply_body ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
        ev_bd  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; \0 := $#parent(#this).v_body ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

        in_seq := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).b_cfg ; \1 := $#parent(#this).ev_bd ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false) ;
        v_ip   := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).in_seq ; #break(#evaluate($#parent(#this).caps.ast.proto)) ), $.caps.constants.\false) ;
        blk_ap := #block(^( arena := $#parent(#this).arena ; kind := block ; \0 := $#parent(#this).v_ip ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

        #break($#block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_cf ; \1 := $#parent(#this).s_ca ; \2 := $#parent(#this).blk_ap ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false))
    ), $.caps.constants.\false)
) ;

! --- 3. Register ApplyExpr and wire into UnaryExpr --- !
fn_env := {
    lookup_sym   := $#parent(#this).fn_lookup_sym ;
    exec_lookup  := $#parent(#this).p_exec_lookup ;
    p_smart_bind := $#parent(#this).p_smart_bind ;
    p_apply_body := $#parent(#this).p_apply_body ;
    build_apply  := $#parent(#this).build_apply_ast ;
    smart_bind   := $#parent(#this).build_smart_bind_ast ;
    iops         := $#parent(#this).iops
} ;
#drop(.h_env) ; h_env := $.fn_env ;

raw_h := ^(
    T   := $.caps.constants.\true ;
    Z   := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    cnt := #evaluate($.caps.syntax.cst_child_count) ;
    acc := #allocate_val($#block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false), $.T) ;
    i   := #allocate_val($.ONE, $.T) ;
    bs  := #evaluate($.caps.syntax.cst_view_bytes) ;
    cf_sym := #block(^(
        lhs := "__cf_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    ), $.caps.constants.\false) ;
    ca_sym := #block(^(
        lhs := "__ca_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    ), $.caps.constants.\false) ;
    (
        a_fn  := $.acc ;
        a_arg := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).i ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;
        .acc  = #evaluate($.env.build_apply) ;
        #drop(.a_fn) ; #drop(.a_arg) ;
        .i    = $#block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) ), $.caps.constants.\false)
    ) while ($.i < $.cnt) ;
    $.acc
) ;
h_apply := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

! ApplyStop = not(("if" / "else" / "while") not_WordChar) !
kw_if    := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_if    ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) ), $.F) ;
kw_else  := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_else  ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) ), $.F) ;
kw_while := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_while ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) ), $.F) ;
kw_ctrl  := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).kw_if ; \1 := $#parent(#this).kw_else ; \2 := $#parent(#this).kw_while ; #break(#evaluate($#parent(#this).c_syn.choice)) ), $.F) ;
not_ctrl := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).kw_ctrl ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) ), $.F) ;

apply_body := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_ws ; \1 := $#parent(#this).not_ctrl ; \2 := $#parent(#this).ref_prefix ; #break(#evaluate($#parent(#this).c_syn.seq)) ), $.F) ;
apply_tail := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).apply_body ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) ), $.F) ;
e_apply    := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_prefix ; \1 := $#parent(#this).apply_tail ; #break(#evaluate($#parent(#this).c_syn.seq)) ), $.F) ;
#block(^( fe := $#parent(#this).fe ; name := ApplyExpr ; expr := $#parent(#this).e_apply ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_apply ; #evaluate($#parent(#this).c_syn.set_rule) ), $.F) ;
ref_apply  := #block(^( fe := $#parent(#this).fe ; name := ApplyExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) ), $.F) ;

! Re-wire UnaryExpr = (UnaryOp _ UnaryExpr) / ApplyExpr !
e_unary2 := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).e_unary_app ; \1 := $#parent(#this).ref_apply ; #break(#evaluate($#parent(#this).c_syn.choice)) ), $.F) ;
#block(^( fe := $#parent(#this).fe ; name := UnaryExpr ; expr := $#parent(#this).e_unary2 ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_unary ; #evaluate($#parent(#this).c_syn.set_rule) ), $.F) ;

! --- 3b. Register LambdaExpr (`param -> body`, strictly single-arg, right-assoc) --- !
raw_h := ^(
    F      := $.caps.constants.\false ;
    Z      := $.caps.constants.u64_zero ;
    ONE    := $.caps.constants.u64_one ;
    n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    p_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z   ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;
    b_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;

    w_arg  := #block(^( arena := $#parent(#this).arena ; sym := __arg ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
    p_arg  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_this ; \1 := $#parent(#this).w_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    d_arg  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    al_p   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_arg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    s_bp   := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).p_ast ; \1 := $#parent(#this).al_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    code_s := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_bp ; \1 := $#parent(#this).b_ast ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false) ;
    code_p := #block(^( ast := $#parent(#this).code_s ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) ), $.caps.constants.\false) ;

    val := { __env := {} ; __code := $#parent(#this).code_p } ;
    #evaluate($.caps.ast.value)
) ;
h_lambda := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

lit_arrow := #block(^( fe := $#parent(#this).fe ; sym := \-\> ; #break(#evaluate($#parent(#this).c_syn.lit)) ), $.F) ;
ref_lam   := #block(^( fe := $#parent(#this).fe ; name := LambdaExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) ), $.F) ;
e_lam_b   := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_lam ; \1 := $#parent(#this).ref_ctrl ; #break(#evaluate($#parent(#this).c_syn.choice)) ), $.F) ;
e_lam     := #block(^(
    fe := $#parent(#this).fe ;
    \0 := $#parent(#this).ref_prefix ;
    \1 := $#parent(#this).ref_ws ;
    \2 := $#parent(#this).lit_arrow ;
    \3 := $#parent(#this).ref_ws ;
    \4 := $#parent(#this).e_lam_b ;
    #break(#evaluate($#parent(#this).c_syn.seq))
), $.F) ;
#block(^( fe := $#parent(#this).fe ; name := LambdaExpr ; expr := $#parent(#this).e_lam ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_lambda ; #evaluate($#parent(#this).c_syn.set_rule) ), $.F) ;

! Wire Infix = BindInfix / AssignInfix / LambdaExpr / ControlExpr !
e_infix_lam := #block(^(
    fe := $#parent(#this).fe ;
    \0 := $#parent(#this).ref_bind2 ;
    \1 := $#parent(#this).ref_assign ;
    \2 := $#parent(#this).ref_lam ;
    \3 := $#parent(#this).ref_ctrl ;
    #break(#evaluate($#parent(#this).c_syn.choice))
), $.F) ;
#block(^( fe := $#parent(#this).fe ; name := Infix ; expr := $#parent(#this).e_infix_lam ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) ), $.F) ;

! --- 4. Upgrade SelfField (`.sym`) to Lexical Upward Lookup (thin glue over `p_exec_lookup`) --- !
raw_h := ^(
    F      := $.caps.constants.\false ;
    Z      := $.caps.constants.u64_zero ;
    n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;

    sym_ast := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;
    bs      := #evaluate($.caps.syntax.cst_view_bytes) ;
    lk_sym  := #block(^(
        lhs := "__lk_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    ), $.caps.constants.\false) ;

    w_lk   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).lk_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
    w_cfg  := #block(^( arena := $#parent(#this).arena ; sym := __cfg ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;

    al_lk  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).sym_ast ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    s_bind := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_lk ; \1 := $#parent(#this).al_lk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

