! --- 4. Upgrade SelfField (`.sym`) to Lexical Upward Lookup (with __fn_env barrier) --- !
raw_h := ^(
    F      := $.caps.constants.\false ;
    Z      := $.caps.constants.u64_zero ;
    n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    a_par  := #block(^( arena := $#parent(#this).arena ; kind := parent ; \0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    sym_ast := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) ), $.caps.constants.\false) ;
    bs      := #evaluate($.caps.syntax.cst_view_bytes) ;
    lk_sym  := #block(^(
        lhs := "__lk_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    ), $.caps.constants.\false) ;

    w_lk   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).lk_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;
    w_sym  := #block(^( arena := $#parent(#this).arena ; sym := sym ; #break(#evaluate($#parent(#this).caps.ast.word)) ), $.caps.constants.\false) ;

    al_lk  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).sym_ast ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    s_bind := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_lk ; \1 := $#parent(#this).al_lk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    p_plk  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_lk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    d_plk  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_plk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    al_s   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_plk ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    b_s    := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_sym ; \1 := $#parent(#this).al_s ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    dr_plk := #block(^( arena := $#parent(#this).arena ; kind := drop ; \0 := $#parent(#this).p_plk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    v_op   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).env.lookup_sym ; #break(#evaluate($#parent(#this).caps.ast.value)) ), $.caps.constants.\false) ;
    ev_op  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; \0 := $#parent(#this).v_op ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    brk_op := #block(^( arena := $#parent(#this).arena ; kind := break ; \0 := $#parent(#this).ev_op ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    in_seq := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).b_s ; \1 := $#parent(#this).dr_plk ; \2 := $#parent(#this).brk_op ; #break(#evaluate($#parent(#this).caps.ast.seq)) ), $.caps.constants.\false) ;
    v_pr   := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).in_seq ; #break(#evaluate($#parent(#this).caps.ast.proto)) ), $.caps.constants.\false) ;
    blk_lp := #block(^( arena := $#parent(#this).arena ; kind := block ; \0 := $#parent(#this).v_pr ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;
    blk_lk := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).blk_lp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) ), $.caps.constants.\false) ;

    \0 := $.s_bind ; \1 := $.blk_lk ;
    #evaluate($.caps.ast.seq)
