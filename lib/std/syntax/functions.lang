! ============================================================================ !
! lib/std/functions.lang — Lexical Upward `.sym` Lookup & Juxtaposition Calls  !
!                                                                              !
! Loaded by lib/std/layer1.lang after ops.lang (written in full Layer 1).      !
! Registers on fe:                                                             !
!   1. ApplyExpr = Prefix (_ ApplyArg)*                                        !
!      Two juxtaposed expressions denote single-argument function application  !
!      (with `if` / `else` / `while` excluded via negative lookahead).         !
!      Callee struct protocol: `{ __code := ^(...), __env := { ... } }`.       !
!      Wired into UnaryExpr fallback: `UnaryExpr = UnaryOp _ UnaryExpr / Apply`!
!   2. Upgrades SelfField (`.sym`) to walk `#this -> #parent(...)` upward      !
!      until found, stopping at a frame with `__fn_env` (checking `__fn_env`   !
!      before returning null). Explicit `#this.sym` remains single-frame.      !
! ============================================================================ !

! --- 1. Pure stageable upward lookup prototype `fn_lookup_sym` --- !
lk_iops := {
    zero_raw8 := $#parent(#this).Z ;
    T_raw     := $#parent(#this).T
} ;

wrap_lk_op := ^(
    #block(^(
        p_iops := $#parent(#this).lk_iops ;
        arena  := $#parent(#this).arena ;
        p_raw  := $#parent(#this).op_raw ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        sym := iops ; w_i := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_iops ; n_i := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; \0 := $.n_i ; \1 := $.n_f ; t_ai := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        kind := bind ; \0 := $.w_i ; \1 := $.t_ai ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; \0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ;
        \0 := $.s2 ; \1 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.\0) ; #drop(.\1) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

op_raw := ^(
    cur  := #allocate_val(#parent(#this), $.iops.T_raw) ;
    res  := #allocate_val(#field($.cur, $.sym), $.iops.T_raw) ;
    done := #allocate_val(~($.res.addr == $.iops.zero_raw8), $.iops.T_raw) ;
    (
        env_p := #field($.cur, __fn_env) ;
        (
            .res  = #field($.env_p, $.sym) ;
            .done = true
        ) if ~($.env_p.addr == $.iops.zero_raw8) else (
            .cur = #parent($.cur) ;
            (
                .done = true
            ) if ($.cur.addr == $.iops.zero_raw8) else (
                .res  = #field($.cur, $.sym) ;
                .done = ~($.res.addr == $.iops.zero_raw8)
            )
        ) ;
        #drop(.env_p)
    ) while ~($.done) ;
    $.res
) ;
fn_lookup_sym := #evaluate($.wrap_lk_op) ; #drop(.op_raw) ;

! --- 2. AST Builder for Juxtaposition Single-Arg Call `callee arg` --- !
build_apply_ast := ^(
    #block(^(
        caps   := $#parent(#this).caps ;
        arena  := $#parent(#this).arena ;
        cf_sym := $#parent(#this).cf_sym ;
        ca_sym := $#parent(#this).ca_sym ;
        a_fn   := $#parent(#this).a_fn ;
        a_arg  := $#parent(#this).a_arg ;
        F      := $.caps.constants.\false ;

        n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        a_par  := #block(^( arena := $#parent(#this).arena ; kind := parent ; \0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        w_cf   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).cf_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_ca   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).ca_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_fn   := #block(^( arena := $#parent(#this).arena ; sym := __fn ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_arg  := #block(^( arena := $#parent(#this).arena ; sym := __arg ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_fenv := #block(^( arena := $#parent(#this).arena ; sym := __fn_env ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_env  := #block(^( arena := $#parent(#this).arena ; sym := __env ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_code := #block(^( arena := $#parent(#this).arena ; sym := __code ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;

        ! Step 1: In caller #this, bind callee & arg to hygienic slots !
        al_fn  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).a_fn ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s_cf   := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_cf ; \1 := $#parent(#this).al_fn ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_arg := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).a_arg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s_ca   := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_ca ; \1 := $#parent(#this).al_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! Step 2a: Inside callee #block, copy __fn and __arg from #parent(#this), then drop caller temps !
        p_pcf  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_cf ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_pcf  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_pcf ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_ifn := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_pcf ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_ifn  := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_fn ; \1 := $#parent(#this).al_ifn ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_pcf := #block(^( arena := $#parent(#this).arena ; kind := drop ; \0 := $#parent(#this).p_pcf ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        p_pca  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_ca ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_pca  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_pca ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_iag := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_pca ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_iag  := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_arg ; \1 := $#parent(#this).al_iag ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_pca := #block(^( arena := $#parent(#this).arena ; kind := drop ; \0 := $#parent(#this).p_pca ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! Step 2b: Mount __fn_env and __code from #this.__fn, then drop #this.__fn !
        p_fn   := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_this ; \1 := $#parent(#this).w_fn ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        p_env  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).p_fn ; \1 := $#parent(#this).w_env ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_env  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_env ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_env := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_env ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_env  := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_fenv ; \1 := $#parent(#this).al_env ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        p_cod  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).p_fn ; \1 := $#parent(#this).w_code ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_cod  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_cod ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_cod := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_cod ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_cod  := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_code ; \1 := $#parent(#this).al_cod ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_fn  := #block(^( arena := $#parent(#this).arena ; kind := drop ; \0 := $#parent(#this).p_fn ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! Step 2c: #break(#evaluate(#deref(#field(#this, __code)))) !
        p_lc   := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_this ; \1 := $#parent(#this).w_code ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_lc   := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_lc ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        ev_lc  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; \0 := $#parent(#this).d_lc ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        brk_lc := #block(^( arena := $#parent(#this).arena ; kind := break ; \0 := $#parent(#this).ev_lc ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        inner_s := #block(^(
            arena := $#parent(#this).arena ;
            \0 := $#parent(#this).b_ifn ;
            \1 := $#parent(#this).b_iag ;
            \2 := $#parent(#this).dr_pcf ;
            \3 := $#parent(#this).dr_pca ;
            \4 := $#parent(#this).b_env ;
            \5 := $#parent(#this).b_cod ;
            \6 := $#parent(#this).dr_fn ;
            \7 := $#parent(#this).brk_lc ;
            #break(#evaluate($#parent(#this).caps.ast.seq))
        )) ;
        v_ip    := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).inner_s ; #break(#evaluate($#parent(#this).caps.ast.proto)) )) ;
        blk_ap  := #block(^( arena := $#parent(#this).arena ; kind := block ; \0 := $#parent(#this).v_ip ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        #break(#block(^(
            arena := $#parent(#this).arena ;
            \0 := $#parent(#this).s_cf ;
            \1 := $#parent(#this).s_ca ;
            \2 := $#parent(#this).blk_ap ;
            #break(#evaluate($#parent(#this).caps.ast.seq))
        )))
    ))
) ;

! --- 3. Register ApplyExpr and wire into UnaryExpr --- !
fn_env := {
    lookup_sym  := $#parent(#this).fn_lookup_sym ;
    build_apply := $#parent(#this).build_apply_ast ;
    iops        := $#parent(#this).iops
} ;
#drop(.h_env) ; h_env := $.fn_env ;

raw_h := ^(
    T   := $.caps.constants.\true ;
    Z   := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    cnt := #evaluate($.caps.syntax.cst_child_count) ;
    acc := #allocate_val(#block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )), $.T) ;
    i   := #allocate_val($.ONE, $.T) ;
    bs  := #evaluate($.caps.syntax.cst_view_bytes) ;
    cf_sym := #block(^(
        lhs := "__cf_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    )) ;
    ca_sym := #block(^(
        lhs := "__ca_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    )) ;
    (
        a_fn  := $.acc ;
        a_arg := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).i ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
        .acc  = #evaluate($.env.build_apply) ;
        #drop(.a_fn) ; #drop(.a_arg) ;
        .i    = #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) ))
    ) while ($.i < $.cnt) ;
    $.acc
) ;
h_apply := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

! ApplyStop = not(("if" / "else" / "while") not_WordChar) !
kw_if    := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_if    ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
kw_else  := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_else  ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
kw_while := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).lit_while ; \1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
kw_ctrl  := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).kw_if ; \1 := $#parent(#this).kw_else ; \2 := $#parent(#this).kw_while ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
not_ctrl := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).kw_ctrl ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;

apply_body := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_ws ; \1 := $#parent(#this).not_ctrl ; \2 := $#parent(#this).ref_prefix ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
apply_tail := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).apply_body ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_apply    := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_prefix ; \1 := $#parent(#this).apply_tail ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := ApplyExpr ; expr := $#parent(#this).e_apply ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_apply ; #evaluate($#parent(#this).c_syn.set_rule) )) ;
ref_apply  := #block(^( fe := $#parent(#this).fe ; name := ApplyExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

! Re-wire UnaryExpr = (UnaryOp _ UnaryExpr) / ApplyExpr !
e_unary2 := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).e_unary_app ; \1 := $#parent(#this).ref_apply ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
#block(^( fe := $#parent(#this).fe ; name := UnaryExpr ; expr := $#parent(#this).e_unary2 ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_unary ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! --- 3b. Register LambdaExpr (`param -> body`, strictly single-arg, right-assoc) --- !
raw_h := ^(
    F      := $.caps.constants.\false ;
    Z      := $.caps.constants.u64_zero ;
    ONE    := $.caps.constants.u64_one ;
    n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    p_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z   ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    b_ast  := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;

    w_arg  := #block(^( arena := $#parent(#this).arena ; sym := __arg ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    p_arg  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_this ; \1 := $#parent(#this).w_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    d_arg  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    al_p   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_arg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    s_bp   := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).p_ast ; \1 := $#parent(#this).al_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    code_s := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_bp ; \1 := $#parent(#this).b_ast ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
    code_p := #block(^( ast := $#parent(#this).code_s ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;

    val := { __env := {} ; __code := $#parent(#this).code_p } ;
    #evaluate($.caps.ast.value)
) ;
h_lambda := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

lit_arrow := #block(^( fe := $#parent(#this).fe ; sym := \-\> ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
ref_lam   := #block(^( fe := $#parent(#this).fe ; name := LambdaExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
e_lam_b   := #block(^( fe := $#parent(#this).fe ; \0 := $#parent(#this).ref_lam ; \1 := $#parent(#this).ref_ctrl ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
e_lam     := #block(^(
    fe := $#parent(#this).fe ;
    \0 := $#parent(#this).ref_prefix ;
    \1 := $#parent(#this).ref_ws ;
    \2 := $#parent(#this).lit_arrow ;
    \3 := $#parent(#this).ref_ws ;
    \4 := $#parent(#this).e_lam_b ;
    #break(#evaluate($#parent(#this).c_syn.seq))
)) ;
#block(^( fe := $#parent(#this).fe ; name := LambdaExpr ; expr := $#parent(#this).e_lam ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_lambda ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! Wire Infix = BindInfix / AssignInfix / LambdaExpr / ControlExpr !
e_infix_lam := #block(^(
    fe := $#parent(#this).fe ;
    \0 := $#parent(#this).ref_bind2 ;
    \1 := $#parent(#this).ref_assign ;
    \2 := $#parent(#this).ref_lam ;
    \3 := $#parent(#this).ref_ctrl ;
    #break(#evaluate($#parent(#this).c_syn.choice))
)) ;
#block(^( fe := $#parent(#this).fe ; name := Infix ; expr := $#parent(#this).e_infix_lam ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! --- 4. Upgrade SelfField (`.sym`) to Lexical Upward Lookup (with __fn_env barrier) --- !
raw_h := ^(
    F      := $.caps.constants.\false ;
    Z      := $.caps.constants.u64_zero ;
    n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    a_par  := #block(^( arena := $#parent(#this).arena ; kind := parent ; \0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    sym_ast := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    bs      := #evaluate($.caps.syntax.cst_view_bytes) ;
    lk_sym  := #block(^(
        lhs := "__lk_" ; rhs := $#parent(#this).bs ;
        bytes := #evaluate($#parent(#this).caps.intrinsics.bytes_concat) ;
        #break(#evaluate($#parent(#this).caps.symbols.intern_bytes))
    )) ;

    w_lk   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).lk_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    w_sym  := #block(^( arena := $#parent(#this).arena ; sym := sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;

    al_lk  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).sym_ast ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    s_bind := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_lk ; \1 := $#parent(#this).al_lk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    p_plk  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_lk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    d_plk  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_plk ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    al_s   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_plk ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    b_s    := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_sym ; \1 := $#parent(#this).al_s ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
