! ============================================================================ !
! lib/std/run.lang — Layer 1 Target Program Runner (with default `libc`)       !
!                                                                              !
! Usage: lang lib/std/start.lang lib/std/run.lang <program.lang>               !
!   1. Stages `lib/std/libc.lang` at compile time -> pure stageable `libc`     !
!   2. Reads & parses <program.lang> from `args.1`                             !
!   3. Lifts `libc` into target Ast and runs via `backends.interpreter.run`    !
! ============================================================================ !

! 1. Stage lib/std/libc.lang at compile time -> pure stageable `libc` value !
path := "lib/std/libc.lang" ;
src  := #evaluate($.c_io.read_file) ; #drop(.path) ;
ast  := #evaluate($.c_syn.parse) ; #drop(.src) ;
libc_p := #evaluate($.c_ast.to_proto) ; #drop(.ast) ;
libc := #block($.libc_p, $.F) ;

! 2. Read & parse target program from CLI `args.1` !
path := $.args.\1 ;
src  := #evaluate($.c_io.read_file) ; #drop(.path) ;
user_ast := #evaluate($.c_syn.parse) ; #drop(.src) ;

! 3. Lift `libc` into target Ast: `#bind(libc, #allocate_val(<libc>, false)) ; <user_ast>` !
a_false := #block(^( arena := $.arena ; val := $.F ; #break(#evaluate($.c_ast.value)) ), $.F) ;
a_w_libc := #block(^( arena := $.arena ; sym := libc ; #break(#evaluate($.c_ast.word)) ), $.F) ;
a_v_libc := #block(^( arena := $.arena ; val := $.libc ; #break(#evaluate($.c_ast.value)) ), $.F) ;
a_alloc_libc := #block(^( arena := $.arena ; kind := allocate_val ; \0 := $.a_v_libc ; \1 := $.a_false ; #break(#evaluate($.c_ast.builtin)) ), $.F) ;
a_bind_libc  := #block(^( arena := $.arena ; kind := bind ; \0 := $.a_w_libc ; \1 := $.a_alloc_libc ; #break(#evaluate($.c_ast.builtin)) ), $.F) ;
ast := #block(^( arena := $.arena ; \0 := $.a_bind_libc ; \1 := $.user_ast ; #break(#evaluate($.c_ast.seq)) ), $.F) ;

! 4. Execute in isolated target RuntimeContext + Evaluator !
run_res := #evaluate($.caps.backends.interpreter.run) ; #drop(.ast) ;
$.run_res
