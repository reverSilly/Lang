! ============================================================================ !
! lib/std/layer1.lang — Stage 2 Full Layer 1 Self-Bootstrap (written in boot1) !
!                                                                              !
! Upgrades fe (fe_boot1) into full fe_layer1:                                  !
!   - Smart `sym := RHS` Pointer/Value dispatcher (no mut/::=/~ sugar)         !
!   - Blocks `{}` / `{ expr }` and assignment `ptr = val`                      !
!   - Literals: i64 (`123`), Bytes (`"..."`), Boolean (`true` / `false`)       !
!   - Shape-dispatched operators: `*` -> `+` / `-` -> `<` / `==`               !
!   - Coroutine resume: `coro @ val`                                           !
!   - English-order suffix control flow: `e1 if cond else e2`, `body while c`  !
! ============================================================================ !

! --- Shorthand aliases & Prototype-Factory intrinsics in root #this --- !
c_con := $.caps.constants ;
W1 := $.c_con.raw1_shape.size ;
W2 := $.c_con.raw2_shape.size ;
W4 := $.c_con.raw4_shape.size ;
W8 := $.c_con.raw8_shape.size ;

p_add_i64  := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.add_int)) )) ;
p_sub_i64  := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.sub_int)) )) ;
p_mul_i64  := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.mul_int)) )) ;
p_lt_i64   := #block(^( signed := $#parent(#this).T ; width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.lt_int)) )) ;
p_eq_i64   := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_bytes)) )) ;
p_eq_sym   := #block(^( width := $#parent(#this).W4 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_bytes)) )) ;
p_u8_to_i64 := #block(^( signed := $#parent(#this).F ; from := $#parent(#this).W1 ; to := $#parent(#this).W8 ; src := b ; #break(#evaluate($#parent(#this).caps.intrinsics.ext_int)) )) ;
p_eq_shape  := #block(^( lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_shape)) )) ;

iops := #block(^(
    add_i64      := $#parent(#this).p_add_i64 ;
    sub_i64      := $#parent(#this).p_sub_i64 ;
    mul_i64      := $#parent(#this).p_mul_i64 ;
    lt_i64       := $#parent(#this).p_lt_i64 ;
    eq_i64       := $#parent(#this).p_eq_i64 ;
    eq_sym       := $#parent(#this).p_eq_sym ;
    u8_to_i64    := $#parent(#this).p_u8_to_i64 ;
    eq_shape     := $#parent(#this).p_eq_shape ;
    raw8_shape   := $#parent(#this).c_con.raw8_shape ;
    symbol_shape := $#parent(#this).c_con.symbol_shape ;
    shape_meta   := $#parent(#this).c_con.shape_meta
)) ;

TWO   := $.W2 ;
FOUR  := $.W4 ;
EIGHT := $.W8 ;
TEN   := #block(^( a := $#parent(#this).EIGHT ; b := $#parent(#this).TWO ; #break(#evaluate($#parent(#this).p_add_i64)) )) ;
ASCII_ZERO := #block(^(
    sym := 0 ;
    index := $#parent(#this).Z ;
    b := #evaluate($#parent(#this).caps.symbols.byte_at) ;
    #break(#evaluate($#parent(#this).p_u8_to_i64))
)) ;

! --- Runtime Shape-dispatched operator prototypes --- !
std_ops := #block(^(
    add := ^(
        is_i64 := #block(^(
            a := #shape($#parent(#this).a) ;
            b := $#parent(#this).iops.raw8_shape ;
            #break(#evaluate($#parent(#this).iops.eq_shape))
        )) ;
        #branch($.is_i64, ^#evaluate($.iops.add_i64), ^#break(type_error_add))
    ) ;
    sub := ^(
        is_i64 := #block(^(
            a := #shape($#parent(#this).a) ;
            b := $#parent(#this).iops.raw8_shape ;
            #break(#evaluate($#parent(#this).iops.eq_shape))
        )) ;
        #branch($.is_i64, ^#evaluate($.iops.sub_i64), ^#break(type_error_sub))
    ) ;
    mul := ^(
        is_i64 := #block(^(
            a := #shape($#parent(#this).a) ;
            b := $#parent(#this).iops.raw8_shape ;
            #break(#evaluate($#parent(#this).iops.eq_shape))
        )) ;
        #branch($.is_i64, ^#evaluate($.iops.mul_i64), ^#break(type_error_mul))
    ) ;
    lt := ^(
        is_i64 := #block(^(
            a := #shape($#parent(#this).a) ;
            b := $#parent(#this).iops.raw8_shape ;
            #break(#evaluate($#parent(#this).iops.eq_shape))
        )) ;
        #branch($.is_i64, ^#evaluate($.iops.lt_i64), ^#break(type_error_lt))
    ) ;
    eq := ^(
        is_i64 := #block(^(
            a := #shape($#parent(#this).a) ;
            b := $#parent(#this).iops.raw8_shape ;
            #break(#evaluate($#parent(#this).iops.eq_shape))
        )) ;
        #branch($.is_i64, ^#evaluate($.iops.eq_i64), ^(
            is_sym := #block(^(
                a := #shape($#parent(#this).a) ;
                b := $#parent(#this).iops.symbol_shape ;
                #break(#evaluate($#parent(#this).iops.eq_shape))
            )) ;
            #branch($.is_sym, ^#evaluate($.iops.eq_sym), ^(
                is_sh := #block(^(
                    a := #shape($#parent(#this).a) ;
                    b := $#parent(#this).iops.shape_meta ;
                    #break(#evaluate($#parent(#this).iops.eq_shape))
                )) ;
                #branch($.is_sh, ^#evaluate($.iops.eq_shape), ^#break(type_error_eq))
            ))
        ))
    )
)) ;

! Wrap each runtime op so it carries ONLY pure stageable `iops` (zero `caps` / zero NativeProto) !
wrap_op := ^(
    #block(^(
        p_iops := $#parent(#this).iops ;
        arena  := $#parent(#this).arena ;
        p_raw  := $#parent(#this).op_raw ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        sym := iops ; w_i := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_iops ; n_i := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; 0 := $.n_i ; 1 := $.n_f ; t_ai := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_i ; 1 := $.t_ai ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; 0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;
        0 := $.s2 ; 1 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.0) ; #drop(.1) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

op_raw := $.std_ops.add ; op_add := #evaluate($.wrap_op) ; #drop(.op_raw) ;
op_raw := $.std_ops.sub ; op_sub := #evaluate($.wrap_op) ; #drop(.op_raw) ;
op_raw := $.std_ops.mul ; op_mul := #evaluate($.wrap_op) ; #drop(.op_raw) ;
op_raw := $.std_ops.lt  ; op_lt  := #evaluate($.wrap_op) ; #drop(.op_raw) ;
op_raw := $.std_ops.eq  ; op_eq  := #evaluate($.wrap_op) ; #drop(.op_raw) ;

ops_env := #block(^(
    add := $#parent(#this).op_add ;
    sub := $#parent(#this).op_sub ;
    mul := $#parent(#this).op_mul ;
    lt  := $#parent(#this).op_lt ;
    eq  := $#parent(#this).op_eq ;
    iops := $#parent(#this).iops ;
    ten := $#parent(#this).TEN ;
    two := $#parent(#this).TWO ;
    zero_ch := $#parent(#this).ASCII_ZERO
)) ;

! Helper: wrap_h_env(raw_h) -> Prototype with both `caps` and `env` injected !
wrap_h_env := ^(
    #block(^(
        arena  := $#parent(#this).arena ;
        p_env  := $#parent(#this).ops_env ;
        p_raw  := $#parent(#this).raw_h ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;

        sym := caps ; w_c := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        sym := capabilities ; w_cap_f := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        kind := this ; a_th := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ;
        kind := field ; 0 := $.a_th ; 1 := $.w_cap_f ; p_cf := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := deref ; 0 := $.p_cf ; n_c := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;
        kind := allocate_val ; 0 := $.n_c ; 1 := $.n_f ; t1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_c ; 1 := $.t1 ; s1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        sym := env ; w_e := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_env ; n_e := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; 0 := $.n_e ; 1 := $.n_f ; t2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_e ; 1 := $.t2 ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; 0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;

        0 := $.s1 ; 1 := $.s2 ; 2 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.0) ; #drop(.1) ; #drop(.2) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

! ============================================================================ !
! 1. Update Delimiter: add { } " * + - < @                                     !
! ============================================================================ !
lit_lbrace := #block(^( fe := $#parent(#this).fe ; sym := { ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_rbrace := #block(^( fe := $#parent(#this).fe ; sym := } ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_quote  := #block(^( fe := $#parent(#this).fe ; sym := " ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_star   := #block(^( fe := $#parent(#this).fe ; sym := * ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_plus   := #block(^( fe := $#parent(#this).fe ; sym := + ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_minus  := #block(^( fe := $#parent(#this).fe ; sym := - ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_lt     := #block(^( fe := $#parent(#this).fe ; sym := < ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_at     := #block(^( fe := $#parent(#this).fe ; sym := @ ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_eqeq   := #block(^( fe := $#parent(#this).fe ; sym := \=\= ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_true   := #block(^( fe := $#parent(#this).fe ; sym := true ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_false  := #block(^( fe := $#parent(#this).fe ; sym := false ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_if     := #block(^( fe := $#parent(#this).fe ; sym := if ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_else   := #block(^( fe := $#parent(#this).fe ; sym := else ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_while  := #block(^( fe := $#parent(#this).fe ; sym := while ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;

old_delim2 := #block(^( fe := $#parent(#this).fe ; name := Delimiter ; #break(#evaluate($#parent(#this).c_syn.get_rule)) )) ;
new_delim2 := #block(^(
    fe := $#parent(#this).fe ;
    0 := $#parent(#this).old_delim2 ;
    1 := $#parent(#this).lit_lbrace ;
    2 := $#parent(#this).lit_rbrace ;
    3 := $#parent(#this).lit_quote ;
    4 := $#parent(#this).lit_star ;
    5 := $#parent(#this).lit_plus ;
    6 := $#parent(#this).lit_minus ;
    7 := $#parent(#this).lit_lt ;
    8 := $#parent(#this).lit_at ;
    #break(#evaluate($#parent(#this).c_syn.choice))
)) ;
#block(^(
    fe := $#parent(#this).fe ; name := Delimiter ; expr := $#parent(#this).new_delim2 ;
    hidden := $#parent(#this).T ; handler := $#parent(#this).Z ;
    #evaluate($#parent(#this).c_syn.set_rule)
)) ;

! WordChar = not_Delimiter any (hidden, for keyword/int boundary lookahead) !
ref_delim := #block(^( fe := $#parent(#this).fe ; name := Delimiter ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
not_delim := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).ref_delim ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;
word_char_expr := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).not_delim ; 1 := $#parent(#this).c_syn.any ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^(
    fe := $#parent(#this).fe ; name := WordChar ; expr := $#parent(#this).word_char_expr ;
    hidden := $#parent(#this).T ; handler := $#parent(#this).Z ;
    #evaluate($#parent(#this).c_syn.set_rule)
)) ;
ref_wc := #block(^( fe := $#parent(#this).fe ; name := WordChar ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
not_wc := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).ref_wc ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;

ref_expr := #block(^( fe := $#parent(#this).fe ; name := Expr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_postfix := #block(^( fe := $#parent(#this).fe ; name := Postfix ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

! ============================================================================ !
! 2. Literals: BoolTrue, BoolFalse, IntLit, StrLit                             !
! ============================================================================ !

! BoolTrue = "true" not_WordChar -> ast.value(true) !
raw_h := ^(
    val := $.caps.constants.true ;
    #evaluate($.caps.ast.value)
) ;
h_true := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;
e_true := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_true ; 1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := BoolTrue ; expr := $#parent(#this).e_true ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_true ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! BoolFalse = "false" not_WordChar -> ast.value(false) !
raw_h := ^(
    val := $.caps.constants.false ;
    #evaluate($.caps.ast.value)
) ;
h_false := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;
e_false := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_false ; 1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := BoolFalse ; expr := $#parent(#this).e_false ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_false ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! IntLit = [0-9]+ not_WordChar -> pure Lang arithmetic -> ast.value(i64) !
raw_h := ^(
    F := $.caps.constants.false ;
    T := $.caps.constants.true ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    bs := #evaluate($.caps.syntax.cst_view_bytes) ;
    bs_sh := #shape($.bs) ;
    n := $.bs_sh.size ;
    #bind(acc, #allocate_val($.Z, $.T) ) ;
    #bind(i, #allocate_val($.Z, $.T) ) ;
    loop_p := ^(
        cond := #block(^( a := $#parent(#this).i ; b := $#parent(#this).n ; #break(#evaluate($#parent(#this).env.iops.lt_i64)) )) ;
        #branch($.cond, ^(
            #drop(.cond) ;
            digit := #block(^(
                bytes := $#parent(#this).bs ; index := $#parent(#this).i ;
                b := #evaluate($#parent(#this).caps.intrinsics.bytes_at) ;
                a := #evaluate($#parent(#this).env.iops.u8_to_i64) ;
                #drop(.b) ;
                b := $#parent(#this).env.zero_ch ;
                #break(#evaluate($#parent(#this).env.iops.sub_i64))
            )) ;
            acc10 := #block(^( a := $#parent(#this).acc ; b := $#parent(#this).env.ten ; #break(#evaluate($#parent(#this).env.iops.mul_i64)) )) ;
            next_acc := #block(^( a := $#parent(#this).acc10 ; b := $#parent(#this).digit ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
            #write(.acc, $.next_acc) ;
            #drop(.digit) ; #drop(.acc10) ; #drop(.next_acc) ;
            next_i := #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
            #write(.i, $.next_i) ;
            #drop(.next_i) ;
            #evaluate($.loop_p)
        ), ^(
            #drop(.cond) ;
            val := $.acc ;
            #evaluate($.caps.ast.value)
        ))
    ) ;
    #evaluate($.loop_p)
) ;
h_int := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;

digit_range := #block(^(
    fe := $#parent(#this).fe ;
    sym := 0 ; index := $#parent(#this).Z ; lo := #evaluate($#parent(#this).c_sym.byte_at) ; #drop(.sym) ;
    sym := 9 ; hi := #evaluate($#parent(#this).c_sym.byte_at) ; #drop(.sym) ;
    #break(#evaluate($#parent(#this).c_syn.range))
)) ;
digits_plus := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).digit_range ; min := $#parent(#this).ONE ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_int := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).digits_plus ; 1 := $#parent(#this).not_wc ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := IntLit ; expr := $#parent(#this).e_int ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_int ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! StrLit = '"' (not_'"' any)* '"' -> bytes_slice(raw, 1, len - 2) -> ast.value(Bytes) !
raw_h := ^(
    bs := #evaluate($.caps.syntax.cst_view_bytes) ;
    bs_sh := #shape($.bs) ;
    inner_len := #block(^( a := $#parent(#this).bs_sh.size ; b := $#parent(#this).env.two ; #break(#evaluate($#parent(#this).env.iops.sub_i64)) )) ;
    sliced := #block(^(
        bytes := $#parent(#this).bs ; start := $#parent(#this).caps.constants.u64_one ; len := $#parent(#this).inner_len ;
        #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice))
    )) ;
    val := $.sliced ;
    #evaluate($.caps.ast.value)
) ;
h_str := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;

not_quote := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).lit_quote ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;
str_char  := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).not_quote ; 1 := $#parent(#this).c_syn.any ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
str_chars := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).str_char ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_str := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_quote ; 1 := $#parent(#this).str_chars ; 2 := $#parent(#this).lit_quote ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := StrLit ; expr := $#parent(#this).e_str ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_str ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 3. Blocks: EmptyBlock {} and NonEmptyBlock { Expr }                          !
! ============================================================================ !
raw_h := ^(
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    p_this := #block(^( ast := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_p    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).p_this ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    kind := block ; 0 := $.v_p ;
    #evaluate($.caps.ast.builtin)
) ;
h_empty_blk := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;
e_empty_blk := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_lbrace ; 1 := $#parent(#this).ref_ws ; 2 := $#parent(#this).lit_rbrace ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := EmptyBlock ; expr := $#parent(#this).e_empty_blk ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_empty_blk ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

raw_h := ^(
    body_ast := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_zero ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    p_body   := #block(^( ast := $#parent(#this).body_ast ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_p      := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).p_body ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    kind := block ; 0 := $.v_p ;
    #evaluate($.caps.ast.builtin)
) ;
h_blk := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;
e_blk := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_lbrace ; 1 := $#parent(#this).ref_ws ; 2 := $#parent(#this).ref_expr ; 3 := $#parent(#this).ref_ws ; 4 := $#parent(#this).lit_rbrace ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := NonEmptyBlock ; expr := $#parent(#this).e_blk ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_blk ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! Prepend EmptyBlock, NonEmptyBlock, StrLit, IntLit, BoolTrue, BoolFalse to Atom !
old_atom2 := #block(^( fe := $#parent(#this).fe ; name := Atom ; #break(#evaluate($#parent(#this).c_syn.get_rule)) )) ;
ref_empty_blk := #block(^( fe := $#parent(#this).fe ; name := EmptyBlock    ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_blk       := #block(^( fe := $#parent(#this).fe ; name := NonEmptyBlock ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_str       := #block(^( fe := $#parent(#this).fe ; name := StrLit        ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_int       := #block(^( fe := $#parent(#this).fe ; name := IntLit        ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_btrue     := #block(^( fe := $#parent(#this).fe ; name := BoolTrue      ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_bfalse    := #block(^( fe := $#parent(#this).fe ; name := BoolFalse     ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
new_atom2 := #block(^(
    fe := $#parent(#this).fe ;
    0 := $#parent(#this).ref_empty_blk ;
    1 := $#parent(#this).ref_blk ;
    2 := $#parent(#this).ref_str ;
    3 := $#parent(#this).ref_int ;
    4 := $#parent(#this).ref_btrue ;
    5 := $#parent(#this).ref_bfalse ;
    6 := $#parent(#this).old_atom2 ;
    #break(#evaluate($#parent(#this).c_syn.choice))
)) ;
#block(^( fe := $#parent(#this).fe ; name := Atom ; expr := $#parent(#this).new_atom2 ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 4. Smart `sym := RHS` Pointer/Value Dispatcher (Upgrading BindInfix)         !
! ============================================================================ !
raw_h := ^(
    F := $.caps.constants.false ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    lhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    rhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;

    ! Common AST pieces !
    n_F   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    w_tmp := #block(^( arena := $#parent(#this).arena ; sym := __bind_v ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    a_par  := #block(^( arena := $#parent(#this).arena ; kind := parent ; 0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    p_tmp  := #block(^( arena := $#parent(#this).arena ; kind := field ; 0 := $#parent(#this).a_this ; 1 := $#parent(#this).w_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    v_tmp  := #block(^( arena := $#parent(#this).arena ; kind := deref ; 0 := $#parent(#this).p_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    drop_tmp := #block(^( arena := $#parent(#this).arena ; kind := drop ; 0 := $#parent(#this).p_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    ! stmt1: #bind(__bind_v, #allocate_val(rhs, false)) !
    al_rhs := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).rhs ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    stmt1  := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_tmp ; 1 := $#parent(#this).al_rhs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    ! cond_is_ptr: #block(^( a := #shape($#parent(#this).__bind_v) ; b := pointer_shape ; #break(#evaluate(eq_shape)) )) !
    par_tmp := #block(^( arena := $#parent(#this).arena ; kind := field ; 0 := $#parent(#this).a_par ; 1 := $#parent(#this).w_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    par_v   := #block(^( arena := $#parent(#this).arena ; kind := deref ; 0 := $#parent(#this).par_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    sh_v    := #block(^( arena := $#parent(#this).arena ; kind := shape ; 0 := $#parent(#this).par_v ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    w_a     := #block(^( arena := $#parent(#this).arena ; sym := a ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    w_b     := #block(^( arena := $#parent(#this).arena ; sym := b ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    al_a    := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).sh_v ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    b_a     := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_a ; 1 := $#parent(#this).al_a ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    v_ps    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).caps.constants.pointer_shape ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    al_b    := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).v_ps ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    b_b     := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_b ; 1 := $#parent(#this).al_b ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    v_eqs   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).env.iops.eq_shape ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    ev_eqs  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; 0 := $#parent(#this).v_eqs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    brk_eq  := #block(^( arena := $#parent(#this).arena ; kind := break ; 0 := $#parent(#this).ev_eqs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    cond_seq := #block(^( arena := $#parent(#this).arena ; 0 := $#parent(#this).b_a ; 1 := $#parent(#this).b_b ; 2 := $#parent(#this).brk_eq ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
    cond_pr  := #block(^( ast := $#parent(#this).cond_seq ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_cond_p := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).cond_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    cond_blk := #block(^( arena := $#parent(#this).arena ; kind := block ; 0 := $#parent(#this).v_cond_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    ! fallback_proto: ^(#bind(lhs, #allocate_val($.__bind_v, false)) ; #drop(.__bind_v)) !
    al_v    := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).v_tmp ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    bind_fb := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).lhs ; 1 := $#parent(#this).al_v ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    fb_seq  := #block(^( arena := $#parent(#this).arena ; 0 := $#parent(#this).bind_fb ; 1 := $#parent(#this).drop_tmp ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
    fb_pr   := #block(^( ast := $#parent(#this).fb_seq ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_fb_p  := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).fb_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! drop_proto: ^(#drop(.__bind_v)) !
    dr_pr   := #block(^( ast := $#parent(#this).drop_tmp ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_dr_p  := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).dr_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! ptr_branch: ^(#branch(#bind(lhs, $.__bind_v), drop_proto, fallback_proto)) !
    try_bind := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).lhs ; 1 := $#parent(#this).v_tmp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    inner_br := #block(^( arena := $#parent(#this).arena ; kind := branch ; 0 := $#parent(#this).try_bind ; 1 := $#parent(#this).v_dr_p ; 2 := $#parent(#this).v_fb_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    ptr_pr   := #block(^( ast := $#parent(#this).inner_br ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_ptr_p  := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).ptr_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! outer_br: #branch(cond_blk, ptr_branch, fallback_proto) !
    outer_br := #block(^( arena := $#parent(#this).arena ; kind := branch ; 0 := $#parent(#this).cond_blk ; 1 := $#parent(#this).v_ptr_p ; 2 := $#parent(#this).v_fb_p ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    0 := $.stmt1 ; 1 := $.outer_br ;
    #evaluate($.caps.ast.seq)
) ;
h_smart_bind := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;

e_bind := #block(^( fe := $#parent(#this).fe ; name := BindInfix ; #break(#evaluate($#parent(#this).c_syn.get_rule)) )) ;
#block(^( fe := $#parent(#this).fe ; name := BindInfix ; expr := $#parent(#this).e_bind ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_smart_bind ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 5. Assignment `ptr = val` (AssignInfix = Postfix _ "=" not_"=" _ Infix)         !
! ============================================================================ !
raw_h := ^(
    lhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_zero ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    rhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_one  ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    kind := write ; 0 := $.lhs ; 1 := $.rhs ;
    #evaluate($.caps.ast.builtin)
) ;
h_assign := #evaluate($.wrap_h_env) ; #drop(.raw_h) ;

lit_eq1 := #block(^( fe := $#parent(#this).fe ; sym := \= ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
not_eq1 := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).lit_eq1 ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;
e_assign := #block(^(
    fe := $#parent(#this).fe ;
    0 := $#parent(#this).ref_postfix ; 1 := $#parent(#this).ref_ws ;
    2 := $#parent(#this).lit_eq1 ; 3 := $#parent(#this).not_eq1 ;
    4 := $#parent(#this).ref_ws ; 5 := $#parent(#this).ref_infix ;
    #break(#evaluate($#parent(#this).c_syn.seq))
)) ;
#block(^( fe := $#parent(#this).fe ; name := AssignInfix ; expr := $#parent(#this).e_assign ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_assign ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 6. Binary Operator AST Builder & Precedence Ladder (* -> +- -> <== -> @)     !
!    Uses collision-free sym_a = intern_bytes(cst_view_bytes(node)) + __op_b   !
! ============================================================================ !
build_binop_ast := ^(
    #block(^(
        caps := $#parent(#this).caps ;
        arena := $#parent(#this).arena ;
        b_sym_a := $#parent(#this).b_sym_a ;
        b_lhs := $#parent(#this).b_lhs ;
        b_rhs := $#parent(#this).b_rhs ;
        b_op := $#parent(#this).b_op ;
        F := $.caps.constants.false ;
        n_F := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        w_sa := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).b_sym_a ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_sb := #block(^( arena := $#parent(#this).arena ; sym := __op_b ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_a  := #block(^( arena := $#parent(#this).arena ; sym := a ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_b  := #block(^( arena := $#parent(#this).arena ; sym := b ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        a_par := #block(^( arena := $#parent(#this).arena ; kind := parent ; 0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! #bind(sym_a, #allocate_val(lhs, false)) !
        al_l := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).b_lhs ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s1   := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_sa ; 1 := $#parent(#this).al_l ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! #bind(__op_b, #allocate_val(rhs, false)) !
        al_r := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).b_rhs ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s2   := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_sb ; 1 := $#parent(#this).al_r ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        ! Inside #block: copy a, b from #parent(#this), drop both from #parent(#this), #break(#evaluate(op_proto)) !
        p_sa := #block(^( arena := $#parent(#this).arena ; kind := field ; 0 := $#parent(#this).a_par ; 1 := $#parent(#this).w_sa ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        p_sb := #block(^( arena := $#parent(#this).arena ; kind := field ; 0 := $#parent(#this).a_par ; 1 := $#parent(#this).w_sb ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_sa := #block(^( arena := $#parent(#this).arena ; kind := deref ; 0 := $#parent(#this).p_sa ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_sb := #block(^( arena := $#parent(#this).arena ; kind := deref ; 0 := $#parent(#this).p_sb ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        al_a := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).d_sa ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        ba   := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_a ; 1 := $#parent(#this).al_a ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_b := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).d_sb ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        bb   := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_b ; 1 := $#parent(#this).al_b ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_a := #block(^( arena := $#parent(#this).arena ; kind := drop ; 0 := $#parent(#this).p_sa ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_b := #block(^( arena := $#parent(#this).arena ; kind := drop ; 0 := $#parent(#this).p_sb ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        v_op := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).b_op ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        ev_o := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; 0 := $#parent(#this).v_op ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        br_o := #block(^( arena := $#parent(#this).arena ; kind := break ; 0 := $#parent(#this).ev_o ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        bseq := #block(^( arena := $#parent(#this).arena ; 0 := $#parent(#this).ba ; 1 := $#parent(#this).bb ; 2 := $#parent(#this).dr_a ; 3 := $#parent(#this).dr_b ; 4 := $#parent(#this).br_o ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
        bpr  := #block(^( ast := $#parent(#this).bseq ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
        v_bp := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).bpr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        s3   := #block(^( arena := $#parent(#this).arena ; kind := block ; 0 := $#parent(#this).v_bp ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        0 := $.s1 ; 1 := $.s2 ; 2 := $.s3 ;
        #break(#evaluate($#parent(#this).caps.ast.seq))
    ))
) ;

! Re-pack ops_env2 with build_binop_ast included !
ops_env2 := #block(^(
    add := $#parent(#this).op_add ;
    sub := $#parent(#this).op_sub ;
    mul := $#parent(#this).op_mul ;
    lt  := $#parent(#this).op_lt ;
    eq  := $#parent(#this).op_eq ;
    iops := $#parent(#this).iops ;
    ten := $#parent(#this).TEN ;
    two := $#parent(#this).TWO ;
    zero_ch := $#parent(#this).ASCII_ZERO ;
    binop := $#parent(#this).build_binop_ast
)) ;

wrap_h_env2 := ^(
    #block(^(
        arena  := $#parent(#this).arena ;
        p_env  := $#parent(#this).ops_env2 ;
        p_raw  := $#parent(#this).raw_h ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;

        sym := caps ; w_c := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        sym := capabilities ; w_cap_f := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        kind := this ; a_th := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ;
        kind := field ; 0 := $.a_th ; 1 := $.w_cap_f ; p_cf := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := deref ; 0 := $.p_cf ; n_c := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;
        kind := allocate_val ; 0 := $.n_c ; 1 := $.n_f ; t1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_c ; 1 := $.t1 ; s1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        sym := env ; w_e := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_env ; n_e := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; 0 := $.n_e ; 1 := $.n_f ; t2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_e ; 1 := $.t2 ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; 0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;

        0 := $.s1 ; 1 := $.s2 ; 2 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.0) ; #drop(.1) ; #drop(.2) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

! --- MulExpr = Prefix (_ "*" _ Prefix)* --- !
raw_h := ^(
    T := $.caps.constants.true ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    cnt := #evaluate($.caps.syntax.cst_child_count) ;
    #bind(acc, #allocate_val(#block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )), $.T)) ;
    #bind(i, #allocate_val($.ONE, $.T) ) ;
    b_sym_a := #block(^( node := $#parent(#this).node ; bytes := #evaluate($#parent(#this).caps.syntax.cst_view_bytes) ; #break(#evaluate($#parent(#this).caps.symbols.intern_bytes)) )) ;
    loop_p := ^(
        cond := #block(^( a := $#parent(#this).i ; b := $#parent(#this).cnt ; #break(#evaluate($#parent(#this).env.iops.lt_i64)) )) ;
        #branch($.cond, ^(
            #drop(.cond) ;
            b_lhs := $.acc ;
            b_rhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).i ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
            b_op  := $.env.mul ;
            #write(.acc, #evaluate($.env.binop)) ;
            #drop(.b_lhs) ; #drop(.b_rhs) ; #drop(.b_op) ;
            next_i := #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
            #write(.i, $.next_i) ;
            #drop(.next_i) ;
            #evaluate($.loop_p)
        ), ^(
            #drop(.cond) ;
            $.acc
        ))
    ) ;
    #evaluate($.loop_p)
) ;
h_mul := #evaluate($.wrap_h_env2) ; #drop(.raw_h) ;

mul_body := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_ws ; 1 := $#parent(#this).lit_star ; 2 := $#parent(#this).ref_ws ; 3 := $#parent(#this).ref_prefix ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
mul_tail := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).mul_body ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_mul := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_prefix ; 1 := $#parent(#this).mul_tail ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := MulExpr ; expr := $#parent(#this).e_mul ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_mul ; #evaluate($#parent(#this).c_syn.set_rule) )) ;
ref_mul := #block(^( fe := $#parent(#this).fe ; name := MulExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

! --- AddOp = "+" / "-" ; AddExpr = MulExpr (_ AddOp _ MulExpr)* --- !
e_addop := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_plus ; 1 := $#parent(#this).lit_minus ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
#block(^( fe := $#parent(#this).fe ; name := AddOp ; expr := $#parent(#this).e_addop ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;
ref_addop := #block(^( fe := $#parent(#this).fe ; name := AddOp ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

raw_h := ^(
    T := $.caps.constants.true ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
