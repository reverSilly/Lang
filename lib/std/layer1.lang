! 7. English-Order Suffix Control Flow:                                        !
!    IfExpr    = CoroExpr _ "if" not_WordChar _ CoroExpr _ "else" not_WordChar _ ControlExpr !
!    WhileExpr = CoroExpr _ "while" not_WordChar _ CoroExpr                       !
! ============================================================================ !
raw_h := ^(
    e_then := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_zero ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    e_cond := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_one  ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    e_else := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).env.two                 ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    p_then := #block(^( ast := $#parent(#this).e_then ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    p_else := #block(^( ast := $#parent(#this).e_else ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_then := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).p_then ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    v_else := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).p_else ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    kind := branch ; 0 := $.e_cond ; 1 := $.v_then ; 2 := $.v_else ;
    #evaluate($.caps.ast.builtin)
) ;
h_if := #evaluate($.wrap_h_env2) ; #drop(.raw_h) ;

raw_h := ^(
    F := $.caps.constants.false ;
    n_F := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
    e_body := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_zero ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    e_cond := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_one  ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    ! Unique loop slot name from CST view bytes so nested while loops never collide !
    w_sym := #block(^( node := $#parent(#this).node ; bytes := #evaluate($#parent(#this).caps.syntax.cst_view_bytes) ; #break(#evaluate($#parent(#this).caps.symbols.intern_bytes)) )) ;
    w_loop := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).w_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    p_loop := #block(^( arena := $#parent(#this).arena ; kind := field ; 0 := $#parent(#this).a_this ; 1 := $#parent(#this).w_loop ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    d_loop := #block(^( arena := $#parent(#this).arena ; kind := deref ; 0 := $#parent(#this).p_loop ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    ev_rec := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; 0 := $#parent(#this).d_loop ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

    ! true_branch: ^(body ; #evaluate($.__w)) !
    tb_seq := #block(^( arena := $#parent(#this).arena ; 0 := $#parent(#this).e_body ; 1 := $#parent(#this).ev_rec ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
    tb_pr  := #block(^( ast := $#parent(#this).tb_seq ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_tb   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).tb_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! false_branch: ^#this !
    fb_pr  := #block(^( ast := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_fb   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).fb_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! step_proto: ^#branch(cond, true_branch, false_branch) !
    br_ast := #block(^( arena := $#parent(#this).arena ; kind := branch ; 0 := $#parent(#this).e_cond ; 1 := $#parent(#this).v_tb ; 2 := $#parent(#this).v_fb ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    st_pr  := #block(^( ast := $#parent(#this).br_ast ; #break(#evaluate($#parent(#this).caps.ast.to_proto)) )) ;
    v_st   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).st_pr ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;

    ! #bind(__w, #allocate_val(step_proto, false)) ; #evaluate($.__w) ; #drop(.__w) !
    al_st  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; 0 := $#parent(#this).v_st ; 1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    s1     := #block(^( arena := $#parent(#this).arena ; kind := bind ; 0 := $#parent(#this).w_loop ; 1 := $#parent(#this).al_st ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    s3     := #block(^( arena := $#parent(#this).arena ; kind := drop ; 0 := $#parent(#this).p_loop ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    0 := $.s1 ; 1 := $.ev_rec ; 2 := $.s3 ;
    #evaluate($.caps.ast.seq)
) ;
h_while := #evaluate($.wrap_h_env2) ; #drop(.raw_h) ;

ref_ctrl := #block(^( fe := $#parent(#this).fe ; name := ControlExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
e_if := #block(^(
    fe := $#parent(#this).fe ;
    0 := $#parent(#this).ref_coro ; 1 := $#parent(#this).ref_ws ;
