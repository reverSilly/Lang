! ============================================================================ !
! lib/std/layer1.lang — Layer 1 Stdlib Orchestrator (written in core_syntax)   !
!                                                                              !
! Assembles the full Layer 1 frontend `fe_layer1` from modular stdlib files:   !
!   1. lib/std/types.lang     — ZST-marker primitive type system (Boolean, ...) !
!   2. lib/std/literals.lang  — Typed literal rules (true/false, IntLit)        !
!   3. lib/std/ops.lang       — Type-dispatched operators (P7 Unary ~ P12 Cmp)  !
!   4. lib/std/functions.lang — Juxtaposition calls & lexical upward `.sym`     !
! ============================================================================ !

! 1. Load lib/std/types.lang -> binds `types` in root #this !
path := "lib/std/types.lang" ;
src := #evaluate($.c_io.read_file) ; #drop(.path) ;
ast := #evaluate($.c_syn.parse) ; #drop(.src) ;
p_types := #evaluate($.c_ast.to_proto) ; #drop(.ast) ;
#evaluate($.p_types) ;

! 2. Load lib/std/literals.lang -> registers Boolean & i64 literals on fe !
path := "lib/std/literals.lang" ;
src := #evaluate($.c_io.read_file) ; #drop(.path) ;
ast := #evaluate($.c_syn.parse) ; #drop(.src) ;
p_lits := #evaluate($.c_ast.to_proto) ; #drop(.ast) ;
#evaluate($.p_lits) ;

! 3. Load lib/std/ops.lang -> registers type-dispatched operators on fe !
path := "lib/std/ops.lang" ;
src := #evaluate($.c_io.read_file) ; #drop(.path) ;
ast := #evaluate($.c_syn.parse) ; #drop(.src) ;
p_ops := #evaluate($.c_ast.to_proto) ; #drop(.ast) ;
#evaluate($.p_ops) ;

! 4. Load lib/std/functions.lang -> registers ApplyExpr & lexical upward `.sym` !
path := "lib/std/functions.lang" ;
src := #evaluate($.c_io.read_file) ; #drop(.path) ;
ast := #evaluate($.c_syn.parse) ; #drop(.src) ;
p_fns := #evaluate($.c_ast.to_proto) ; #drop(.ast) ;
#evaluate($.p_fns) ;

! Export full Layer 1 frontend as fe_layer1 !
fe_layer1 := $.fe ;
$.fe_layer1
