    #break(#evaluate($#parent(#this).c_syn.seq))
)) ;
#block(^( fe := $#parent(#this).fe ; name := WhileExpr ; expr := $#parent(#this).e_while ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_while ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

ref_if    := #block(^( fe := $#parent(#this).fe ; name := IfExpr    ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_while := #block(^( fe := $#parent(#this).fe ; name := WhileExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
e_ctrl := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_if ; 1 := $#parent(#this).ref_while ; 2 := $#parent(#this).ref_coro ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
#block(^( fe := $#parent(#this).fe ; name := ControlExpr ; expr := $#parent(#this).e_ctrl ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

