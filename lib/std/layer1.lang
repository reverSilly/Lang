)) ;
#block(^( fe := $#parent(#this).fe ; name := IfExpr ; expr := $#parent(#this).e_if ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_if ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

e_while := #block(^(
