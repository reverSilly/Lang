! ============================================================================ !
! lib/std/boot1.lang — Stage 1.5 Bootstrap (uses ^Expr, .a, $p from boot0)     !
!                                                                              !
! Installs Postfix (p.a) and basic BindInfix (x := expr) on fe -> fe_boot1,    !
! then reads, parses (with fe_boot1), and evaluates lib/std/layer1.lang.       !
! ============================================================================ !

! Helper: wrap_h(raw_h) -> self-contained Prototype with `caps` injected       !
#bind(wrap_h, #allocate_val(^(
    #bind(sym, #allocate_val(caps, $.F)) ;
    #bind(w_caps, #allocate_val(#evaluate($#field(.c_ast, word)), $.F)) ;
    #drop(.sym) ;

    #bind(kind, #allocate_val(this, $.F)) ;
    #bind(b1_th, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ;
    #bind(sym, #allocate_val(capabilities, $.F)) ;
    #bind(w_cb1, #allocate_val(#evaluate($#field(.c_ast, word)), $.F)) ;
    #drop(.sym) ;
    #bind(kind, #allocate_val(field, $.F)) ;
    #bind(0, #allocate_val($.b1_th, $.F)) ;
    #bind(1, #allocate_val($.w_cb1, $.F)) ;
    #bind(p_cb1, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ; #drop(.1) ; #drop(.b1_th) ; #drop(.w_cb1) ;
    #bind(kind, #allocate_val(deref, $.F)) ;
    #bind(0, #allocate_val($.p_cb1, $.F)) ;
    #bind(n_caps_v, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ; #drop(.p_cb1) ;

    #bind(val, #allocate_val($.raw_h, $.F)) ;
    #bind(n_raw_h, #allocate_val(#evaluate($#field(.c_ast, value)), $.F)) ;
    #drop(.val) ;

    #bind(kind, #allocate_val(allocate_val, $.F)) ;
    #bind(0, #allocate_val($.n_caps_v, $.F)) ;
    #bind(1, #allocate_val($.n_F, $.F)) ;
    #bind(t_alloc, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ; #drop(.1) ;

    #bind(kind, #allocate_val(bind, $.F)) ;
    #bind(0, #allocate_val($.w_caps, $.F)) ;
    #bind(1, #allocate_val($.t_alloc, $.F)) ;
    #bind(s_bind, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ; #drop(.1) ;

    #bind(kind, #allocate_val(evaluate, $.F)) ;
    #bind(0, #allocate_val($.n_raw_h, $.F)) ;
    #bind(s_eval, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ;

    #bind(0, #allocate_val($.s_bind, $.F)) ;
    #bind(1, #allocate_val($.s_eval, $.F)) ;
    #bind(ast, #allocate_val(#evaluate($#field(.c_ast, seq)), $.F)) ;
    #drop(.0) ; #drop(.1) ;

    #bind(res_p, #allocate_val(#evaluate($#field(.c_ast, to_proto)), $.F)) ;
    #drop(.ast) ; #drop(.w_caps) ; #drop(.n_caps_v) ; #drop(.n_raw_h) ;
    #drop(.t_alloc) ; #drop(.s_bind) ; #drop(.s_eval) ;
    $.res_p
), $.F)) ;

! ---------------------------------------------------------------------------- !
! Rule 2b: Postfix = Atom (_ "." _ Word)* -> left-fold #field(acc, child_i)    !
! ---------------------------------------------------------------------------- !
#bind(raw_h, #allocate_val(^(
    #bind(F, #allocate_val($#field(#field(.caps, constants), false), $#field(#field(.caps, constants), false))) ;
    #bind(T, #allocate_val($#field(#field(.caps, constants), true), $.F)) ;
    #bind(Z, #allocate_val($#field(#field(.caps, constants), u64_zero), $.F)) ;
    #bind(ONE, #allocate_val($#field(#field(.caps, constants), u64_one), $.F)) ;
    #bind(c_syn, #allocate_val($#field(.caps, syntax), $.F)) ;
    #bind(c_ast, #allocate_val($#field(.caps, ast), $.F)) ;
    #bind(c_int, #allocate_val($#field(.caps, intrinsics), $.F)) ;
    #bind(W8, #allocate_val($#field($#field(#field(.caps, constants), raw8_shape), size), $.F)) ;
    #bind(lt_u64, #block(^(
        #bind(signed, #allocate_val($#field(#parent(#this), F), $#field(#parent(#this), F))) ;
        #bind(width, #allocate_val($#field(#parent(#this), W8), $#field(#parent(#this), F))) ;
        #bind(lhs, #allocate_val(a, $#field(#parent(#this), F))) ;
        #bind(rhs, #allocate_val(b, $#field(#parent(#this), F))) ;
        #break(#evaluate($#field(#field(#parent(#this), c_int), lt_int)))
    ), $.F)) ;
    #bind(add_u64, #block(^(
        #bind(width, #allocate_val($#field(#parent(#this), W8), $#field(#parent(#this), F))) ;
        #bind(lhs, #allocate_val(a, $#field(#parent(#this), F))) ;
        #bind(rhs, #allocate_val(b, $#field(#parent(#this), F))) ;
        #break(#evaluate($#field(#field(#parent(#this), c_int), add_int)))
    ), $.F)) ;

    #bind(cnt, #allocate_val(#evaluate($#field(.c_syn, cst_child_count)), $.F)) ;
    #bind(index, #allocate_val($.Z, $.T)) ;
    #bind(acc, #allocate_val(#evaluate($#field(.c_syn, cst_eval_child)), $.T)) ;
    #write(.index, $.ONE) ;

    #bind(loop_p, #allocate_val(^(
        #bind(a, #allocate_val($.index, $.F)) ;
        #bind(b, #allocate_val($.cnt, $.F)) ;
        #bind(cond, #allocate_val(#evaluate($.lt_u64), $.F)) ;
        #drop(.a) ; #drop(.b) ;
        #branch($.cond, ^(
            #drop(.cond) ;
            #bind(rhs, #allocate_val(#evaluate($#field(.c_syn, cst_eval_child)), $.F)) ;
            #bind(kind, #allocate_val(field, $.F)) ;
            #bind(0, #allocate_val($.acc, $.F)) ;
            #bind(1, #allocate_val($.rhs, $.F)) ;
            #write(.acc, #evaluate($#field(.c_ast, builtin))) ;
            #drop(.rhs) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

            #bind(a, #allocate_val($.index, $.F)) ;
            #bind(b, #allocate_val($.ONE, $.F)) ;
            #write(.index, #evaluate($.add_u64)) ;
            #drop(.a) ; #drop(.b) ;
            #evaluate($.loop_p)
        ), ^(
            #drop(.cond) ;
            $.acc
        ))
    ), $.F)) ;
    #evaluate($.loop_p)
), $.F)) ;

#bind(h_postfix, #allocate_val(#evaluate($.wrap_h), $.F)) ;
#drop(.raw_h) ; #drop(.res_p) ;

#bind(name, #allocate_val(Postfix, $.F)) ;
#bind(expr, #allocate_val($.postfix_expr, $.F)) ;
#bind(hidden, #allocate_val($.F, $.F)) ;
#bind(handler, #allocate_val($.h_postfix, $.F)) ;
#evaluate($#field(.c_syn, set_rule)) ;
#drop(.name) ; #drop(.expr) ; #drop(.hidden) ; #drop(.handler) ;

! ---------------------------------------------------------------------------- !
! Rule 4: BindInfix = Prefix _ ":=" _ Infix -> #bind(lhs, #allocate_val(rhs,F))!
! ---------------------------------------------------------------------------- !
#bind(raw_h, #allocate_val(^(
    #bind(F, #allocate_val($#field(#field(.caps, constants), false), $#field(#field(.caps, constants), false))) ;
    #bind(Z, #allocate_val($#field(#field(.caps, constants), u64_zero), $.F)) ;
    #bind(ONE, #allocate_val($#field(#field(.caps, constants), u64_one), $.F)) ;
    #bind(c_syn, #allocate_val($#field(.caps, syntax), $.F)) ;
    #bind(c_ast, #allocate_val($#field(.caps, ast), $.F)) ;

    #bind(index, #allocate_val($.Z, $.F)) ;
    #bind(lhs, #allocate_val(#evaluate($#field(.c_syn, cst_eval_child)), $.F)) ;
    #drop(.index) ;

    #bind(index, #allocate_val($.ONE, $.F)) ;
    #bind(rhs, #allocate_val(#evaluate($#field(.c_syn, cst_eval_child)), $.F)) ;
    #drop(.index) ;

    #bind(val, #allocate_val($.F, $.F)) ;
    #bind(n_false, #allocate_val(#evaluate($#field(.c_ast, value)), $.F)) ;
    #drop(.val) ;

    #bind(kind, #allocate_val(allocate_val, $.F)) ;
    #bind(0, #allocate_val($.rhs, $.F)) ;
    #bind(1, #allocate_val($.n_false, $.F)) ;
    #bind(alloc_node, #allocate_val(#evaluate($#field(.c_ast, builtin)), $.F)) ;
    #drop(.kind) ; #drop(.0) ; #drop(.1) ;

    #bind(kind, #allocate_val(bind, $.F)) ;
    #bind(0, #allocate_val($.lhs, $.F)) ;
    #bind(1, #allocate_val($.alloc_node, $.F)) ;
    #evaluate($#field(.c_ast, builtin))
), $.F)) ;

#bind(h_bind_basic, #allocate_val(#evaluate($.wrap_h), $.F)) ;
#drop(.raw_h) ; #drop(.res_p) ;

#bind(0, #allocate_val($.ref_prefix, $.F)) ;
#bind(1, #allocate_val($.ref_ws, $.F)) ;
#bind(2, #allocate_val($.lit_def, $.F)) ;
#bind(3, #allocate_val($.ref_ws, $.F)) ;
#bind(4, #allocate_val($.ref_infix, $.F)) ;
#bind(expr, #allocate_val(#evaluate($#field(.c_syn, seq)), $.F)) ;
#drop(.0) ; #drop(.1) ; #drop(.2) ; #drop(.3) ; #drop(.4) ;

#bind(name, #allocate_val(BindInfix, $.F)) ;
#bind(hidden, #allocate_val($.F, $.F)) ;
#bind(handler, #allocate_val($.h_bind_basic, $.F)) ;
#evaluate($#field(.c_syn, set_rule)) ;
#drop(.name) ; #drop(.expr) ; #drop(.hidden) ; #drop(.handler) ;

#bind(name, #allocate_val(BindInfix, $.F)) ;
#bind(ref_bind, #allocate_val(#evaluate($#field(.c_syn, ref)), $.F)) ;
#drop(.name) ;

#bind(0, #allocate_val($.ref_bind, $.F)) ;
#bind(1, #allocate_val($.old_infix, $.F)) ;
#bind(expr, #allocate_val(#evaluate($#field(.c_syn, choice)), $.F)) ;
#drop(.0) ; #drop(.1) ;

#bind(name, #allocate_val(Infix, $.F)) ;
#bind(hidden, #allocate_val($.F, $.F)) ;
#bind(handler, #allocate_val($.Z, $.F)) ;
#evaluate($#field(.c_syn, set_rule)) ;
#drop(.name) ; #drop(.expr) ; #drop(.hidden) ; #drop(.handler) ;

! ---------------------------------------------------------------------------- !
! Now fe == fe_boot1 (has ^Expr, .a, p.a, $p, x := expr)                       !
! Load, parse, and evaluate Stage 2: lib/std/layer1.lang                       !
! ---------------------------------------------------------------------------- !
#bind(sym, #allocate_val(lib/std/boot/core_syntax\.lang, $.F)) ;
#bind(path, #allocate_val(#evaluate($#field(.c_sym, to_bytes)), $.F)) ;
#drop(.sym) ;

#bind(src, #allocate_val(#evaluate($#field(.c_io, read_file)), $.F)) ;
#drop(.path) ;

#bind(ast, #allocate_val(#evaluate($#field(.c_syn, parse)), $.F)) ;
#drop(.src) ;
#bind(layer1_proto, #allocate_val(#evaluate($#field(.c_ast, to_proto)), $.F)) ;
#drop(.ast) ;

#evaluate($.layer1_proto)
