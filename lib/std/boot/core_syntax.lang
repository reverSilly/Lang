! ============================================================================ !
! lib/std/boot/core_syntax.lang — Type-Agnostic Layer 1 Structural Syntax      !
! (Written in fe_boot1: ^, .a, p.a, $p, basic :=)                              !
!                                                                              !
! Installs ONLY type-independent structural syntax on fe:                      !
!   - Delimiters: { } " + - * / % ~ < > = & | @                                !
!   - BytesLit ("..." with \x unescape)                                        !
!   - EmptyBlock {} and NonEmptyBlock { Expr }                                 !
!   - DerefPrefix ($) > CoroExpr (@) > Prefix (^) > OpExpr (hook for ops.lang) !
!   - IfExpr (`a if c else b`) & WhileExpr (`body while c`), accepting both    !
!     raw bytes(1,1) and stdlib Boolean (`{ __raw: bytes(1,1), ... }`)         !
!   - Smart BindInfix (`:=`) & AssignInfix (`=`)                               !
!                                                                              !
! Then loads lib/std/layer1.lang (written in core_syntax Layer 1) to assemble  !
! types.lang -> literals.lang -> ops.lang.                                     !
! ============================================================================ !

! --- Shorthand aliases & low-level raw intrinsics in root #this --- !
c_con := $.caps.constants ;
W1 := $.c_con.raw1_shape.size ;
W2 := $.c_con.raw2_shape.size ;
W4 := $.c_con.raw4_shape.size ;
W8 := $.c_con.raw8_shape.size ;

p_add_i64   := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.add_int)) )) ;
p_sub_i64   := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.sub_int)) )) ;
p_mul_i64   := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.mul_int)) )) ;
p_lt_i64    := #block(^( signed := $#parent(#this).T ; width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.lt_int)) )) ;
p_eq_i64    := #block(^( width := $#parent(#this).W8 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_bytes)) )) ;
p_eq_sym    := #block(^( width := $#parent(#this).W4 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_bytes)) )) ;
p_eq_raw1   := #block(^( width := $#parent(#this).W1 ; lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_bytes)) )) ;
p_u8_to_i64 := #block(^( signed := $#parent(#this).F ; from := $#parent(#this).W1 ; to := $#parent(#this).W8 ; src := b ; #break(#evaluate($#parent(#this).caps.intrinsics.ext_int)) )) ;
p_eq_shape  := #block(^( lhs := a ; rhs := b ; #break(#evaluate($#parent(#this).caps.intrinsics.eq_shape)) )) ;

iops := #block(^(
    add_i64      := $#parent(#this).p_add_i64 ;
    sub_i64      := $#parent(#this).p_sub_i64 ;
    mul_i64      := $#parent(#this).p_mul_i64 ;
    lt_i64       := $#parent(#this).p_lt_i64 ;
    eq_i64       := $#parent(#this).p_eq_i64 ;
    eq_sym       := $#parent(#this).p_eq_sym ;
    eq_raw1      := $#parent(#this).p_eq_raw1 ;
    u8_to_i64    := $#parent(#this).p_u8_to_i64 ;
    eq_shape     := $#parent(#this).p_eq_shape ;
    raw1_shape   := $#parent(#this).c_con.raw1_shape ;
    raw8_shape   := $#parent(#this).c_con.raw8_shape ;
    symbol_shape := $#parent(#this).c_con.symbol_shape ;
    shape_meta   := $#parent(#this).c_con.shape_meta
)) ;

TWO   := $.W2 ;
FOUR  := $.W4 ;
EIGHT := $.W8 ;
TEN   := #block(^( a := $#parent(#this).EIGHT ; b := $#parent(#this).TWO ; #break(#evaluate($#parent(#this).p_add_i64)) )) ;
ASCII_ZERO := #block(^(
    sym := 0 ; index := $#parent(#this).Z ;
    b := #evaluate($#parent(#this).caps.symbols.byte_at) ;
    #break(#evaluate($#parent(#this).p_u8_to_i64))
)) ;
ASCII_BSLASH := #block(^(
    sym := \\ ; index := $#parent(#this).Z ;
    b := #evaluate($#parent(#this).caps.symbols.byte_at) ;
    #break(#evaluate($#parent(#this).p_u8_to_i64))
)) ;

! Environment passed into core_syntax CST handlers !
core_env := #block(^(
    iops         := $#parent(#this).iops ;
    ten          := $#parent(#this).TEN ;
    two          := $#parent(#this).TWO ;
    zero_ch      := $#parent(#this).ASCII_ZERO ;
    bslash_ch    := $#parent(#this).ASCII_BSLASH
)) ;

! Reusable handler wrapper: injects `caps` (from #this.capabilities) and `env` (`h_env`) !
wrap_h_with := ^(
    #block(^(
        arena := $#parent(#this).arena ;
        p_env := $#parent(#this).h_env ;
        p_raw := $#parent(#this).raw_h ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;

        sym := caps ; w_c := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        sym := capabilities ; w_cap_f := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        kind := this ; a_th := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ;
        kind := field ; 0 := $.a_th ; 1 := $.w_cap_f ; p_cf := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := deref ; 0 := $.p_cf ; n_c := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;
        kind := allocate_val ; 0 := $.n_c ; 1 := $.n_f ; t1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_c ; 1 := $.t1 ; s1 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        sym := env ; w_e := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_env ; n_e := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; 0 := $.n_e ; 1 := $.n_f ; t2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;
        kind := bind ; 0 := $.w_e ; 1 := $.t2 ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ; #drop(.1) ;

        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; 0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.0) ;

        0 := $.s1 ; 1 := $.s2 ; 2 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.0) ; #drop(.1) ; #drop(.2) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

h_env := $.core_env ;

! ============================================================================ !
! 1. Update Delimiter: add { } " + - * / % ~ < > & | @                         !
! ============================================================================ !
lit_lbrace := #block(^( fe := $#parent(#this).fe ; sym := { ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_rbrace := #block(^( fe := $#parent(#this).fe ; sym := } ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_quote  := #block(^( fe := $#parent(#this).fe ; sym := " ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_plus   := #block(^( fe := $#parent(#this).fe ; sym := + ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_minus  := #block(^( fe := $#parent(#this).fe ; sym := - ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_star   := #block(^( fe := $#parent(#this).fe ; sym := * ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_slash  := #block(^( fe := $#parent(#this).fe ; sym := / ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_pct    := #block(^( fe := $#parent(#this).fe ; sym := % ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_tilde  := #block(^( fe := $#parent(#this).fe ; sym := ~ ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_lt     := #block(^( fe := $#parent(#this).fe ; sym := < ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_gt     := #block(^( fe := $#parent(#this).fe ; sym := > ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_amp    := #block(^( fe := $#parent(#this).fe ; sym := & ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_pipe   := #block(^( fe := $#parent(#this).fe ; sym := | ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_at     := #block(^( fe := $#parent(#this).fe ; sym := @ ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_if     := #block(^( fe := $#parent(#this).fe ; sym := if ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_else   := #block(^( fe := $#parent(#this).fe ; sym := else ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;
lit_while  := #block(^( fe := $#parent(#this).fe ; sym := while ; #break(#evaluate($#parent(#this).c_syn.lit)) )) ;

old_delim2 := #block(^( fe := $#parent(#this).fe ; name := Delimiter ; #break(#evaluate($#parent(#this).c_syn.get_rule)) )) ;
new_delim2 := #block(^(
    fe := $#parent(#this).fe ;
    0  := $#parent(#this).old_delim2 ;
    1  := $#parent(#this).lit_lbrace ;
    2  := $#parent(#this).lit_rbrace ;
    3  := $#parent(#this).lit_quote ;
    4  := $#parent(#this).lit_plus ;
    5  := $#parent(#this).lit_minus ;
    6  := $#parent(#this).lit_star ;
    7  := $#parent(#this).lit_slash ;
    8  := $#parent(#this).lit_pct ;
    9  := $#parent(#this).lit_tilde ;
    10 := $#parent(#this).lit_lt ;
    11 := $#parent(#this).lit_gt ;
    12 := $#parent(#this).lit_amp ;
    13 := $#parent(#this).lit_pipe ;
    14 := $#parent(#this).lit_at ;
    #break(#evaluate($#parent(#this).c_syn.choice))
)) ;
#block(^(
    fe := $#parent(#this).fe ; name := Delimiter ; expr := $#parent(#this).new_delim2 ;
    hidden := $#parent(#this).T ; handler := $#parent(#this).Z ;
    #evaluate($#parent(#this).c_syn.set_rule)
)) ;

ref_escaped := #block(^( fe := $#parent(#this).fe ; name := Escaped  ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_wc      := #block(^( fe := $#parent(#this).fe ; name := WordChar ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
not_wc      := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).ref_wc ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;
ref_expr    := #block(^( fe := $#parent(#this).fe ; name := Expr     ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_postfix := #block(^( fe := $#parent(#this).fe ; name := Postfix  ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

! ============================================================================ !
! 2. BytesLit = '"' (Escaped / (not_'"' any))* '"' -> RawBytes                 !
! ============================================================================ !
raw_h := ^(
    T := $.caps.constants.true ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    bs := #evaluate($.caps.syntax.cst_view_bytes) ;
    bs_sh := #shape($.bs) ;
    inner_len := #block(^( a := $#parent(#this).bs_sh.size ; b := $#parent(#this).env.two ; #break(#evaluate($#parent(#this).env.iops.sub_i64)) )) ;
    raw := #block(^(
        bytes := $#parent(#this).bs ; start := $#parent(#this).ONE ; len := $#parent(#this).inner_len ;
        #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice))
    )) ;
    empty_b := #block(^(
        bytes := $#parent(#this).raw ; start := $#parent(#this).Z ; len := $#parent(#this).Z ;
        #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice))
    )) ;
    #bind(acc, #allocate_val($.empty_b, $.T)) ;
    #bind(seg, #allocate_val($.Z, $.T)) ;
    #bind(i, #allocate_val($.Z, $.T)) ;
    loop_p := ^(
        cond := #block(^( a := $#parent(#this).i ; b := $#parent(#this).inner_len ; #break(#evaluate($#parent(#this).env.iops.lt_i64)) )) ;
        #branch($.cond, ^(
            #drop(.cond) ;
            ch := #block(^(
                bytes := $#parent(#this).raw ; index := $#parent(#this).i ;
                b := #evaluate($#parent(#this).caps.intrinsics.bytes_at) ;
                #break(#evaluate($#parent(#this).env.iops.u8_to_i64))
            )) ;
            is_bs := #block(^( a := $#parent(#this).ch ; b := $#parent(#this).env.bslash_ch ; #break(#evaluate($#parent(#this).env.iops.eq_i64)) )) ;
            #drop(.ch) ;
            #branch($.is_bs, ^(
                #drop(.is_bs) ;
                seg_len := #block(^( a := $#parent(#this).i ; b := $#parent(#this).seg ; #break(#evaluate($#parent(#this).env.iops.sub_i64)) )) ;
                part := #block(^( bytes := $#parent(#this).raw ; start := $#parent(#this).seg ; len := $#parent(#this).seg_len ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice)) )) ;
                acc1 := #block(^( lhs := $#parent(#this).acc ; rhs := $#parent(#this).part ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_concat)) )) ;
                i1 := #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
                esc_b := #block(^( bytes := $#parent(#this).raw ; start := $#parent(#this).i1 ; len := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice)) )) ;
                acc2 := #block(^( lhs := $#parent(#this).acc1 ; rhs := $#parent(#this).esc_b ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_concat)) )) ;
                i2 := #block(^( a := $#parent(#this).i1 ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
                #drop(.acc) ; #bind(acc, #allocate_val($.acc2, $.T)) ;
                #write(.i, $.i2) ;
                #write(.seg, $.i2) ;
                #drop(.seg_len) ; #drop(.part) ; #drop(.acc1) ; #drop(.i1) ; #drop(.esc_b) ; #drop(.acc2) ; #drop(.i2) ;
                #evaluate($.loop_p)
            ), ^(
                #drop(.is_bs) ;
                next_i := #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
                #write(.i, $.next_i) ;
                #drop(.next_i) ;
                #evaluate($.loop_p)
            ))
        ), ^(
            #drop(.cond) ;
            tail_len := #block(^( a := $#parent(#this).inner_len ; b := $#parent(#this).seg ; #break(#evaluate($#parent(#this).env.iops.sub_i64)) )) ;
            tail := #block(^( bytes := $#parent(#this).raw ; start := $#parent(#this).seg ; len := $#parent(#this).tail_len ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_slice)) )) ;
            final_b := #block(^( lhs := $#parent(#this).acc ; rhs := $#parent(#this).tail ; #break(#evaluate($#parent(#this).caps.intrinsics.bytes_concat)) )) ;
            val := $.final_b ;
            #evaluate($.caps.ast.value)
        ))
    ) ;
    #evaluate($.loop_p)
) ;
h_bytes := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

not_quote := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).lit_quote ; positive := $#parent(#this).F ; #break(#evaluate($#parent(#this).c_syn.lookahead)) )) ;
raw_bchar := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).not_quote ; 1 := $#parent(#this).c_syn.any ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
bytes_char := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_escaped ; 1 := $#parent(#this).raw_bchar ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
bytes_chars := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).bytes_char ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_bytes := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_quote ; 1 := $#parent(#this).bytes_chars ; 2 := $#parent(#this).lit_quote ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := BytesLit ; expr := $#parent(#this).e_bytes ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_bytes ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 3. Blocks: EmptyBlock {} and NonEmptyBlock { Expr }                          !
! ============================================================================ !
raw_h := ^(
    a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
    v_p    := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.proto)) )) ;
    kind := block ; 0 := $.v_p ;
    #evaluate($.caps.ast.builtin)
) ;
h_empty_blk := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;
e_empty_blk := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_lbrace ; 1 := $#parent(#this).ref_ws ; 2 := $#parent(#this).lit_rbrace ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := EmptyBlock ; expr := $#parent(#this).e_empty_blk ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_empty_blk ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

raw_h := ^(
    body_ast := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).caps.constants.u64_zero ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
    v_p      := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).body_ast ; #break(#evaluate($#parent(#this).caps.ast.proto)) )) ;
    kind := block ; 0 := $.v_p ;
    #evaluate($.caps.ast.builtin)
) ;
h_blk := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;
e_blk := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_lbrace ; 1 := $#parent(#this).ref_ws ; 2 := $#parent(#this).ref_expr ; 3 := $#parent(#this).ref_ws ; 4 := $#parent(#this).lit_rbrace ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := NonEmptyBlock ; expr := $#parent(#this).e_blk ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_blk ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! Prepend EmptyBlock, NonEmptyBlock, BytesLit to Atom !
old_atom2 := #block(^( fe := $#parent(#this).fe ; name := Atom ; #break(#evaluate($#parent(#this).c_syn.get_rule)) )) ;
ref_empty_blk := #block(^( fe := $#parent(#this).fe ; name := EmptyBlock    ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_blk       := #block(^( fe := $#parent(#this).fe ; name := NonEmptyBlock ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
ref_str       := #block(^( fe := $#parent(#this).fe ; name := BytesLit      ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
new_atom2 := #block(^(
    fe := $#parent(#this).fe ;
    0 := $#parent(#this).ref_empty_blk ;
    1 := $#parent(#this).ref_blk ;
    2 := $#parent(#this).ref_str ;
    3 := $#parent(#this).old_atom2 ;
    #break(#evaluate($#parent(#this).c_syn.choice))
)) ;
#block(^( fe := $#parent(#this).fe ; name := Atom ; expr := $#parent(#this).new_atom2 ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

! ============================================================================ !
! 4. DerefPrefix ($) > CoroExpr (@) > Prefix (^) > OpExpr (extensible hook)    !
! ============================================================================ !
ref_deref_p := #block(^( fe := $#parent(#this).fe ; name := DerefPrefix ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;
e_deref2 := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).lit_dollar ; 1 := $#parent(#this).ref_ws ; 2 := $#parent(#this).ref_deref_p ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := Deref ; expr := $#parent(#this).e_deref2 ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_deref ; #evaluate($#parent(#this).c_syn.set_rule) )) ;
e_deref_p := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_deref ; 1 := $#parent(#this).ref_postfix ; #break(#evaluate($#parent(#this).c_syn.choice)) )) ;
#block(^( fe := $#parent(#this).fe ; name := DerefPrefix ; expr := $#parent(#this).e_deref_p ; hidden := $#parent(#this).F ; handler := $#parent(#this).Z ; #evaluate($#parent(#this).c_syn.set_rule) )) ;

raw_h := ^(
    T := $.caps.constants.true ;
    Z := $.caps.constants.u64_zero ;
    ONE := $.caps.constants.u64_one ;
    cnt := #evaluate($.caps.syntax.cst_child_count) ;
    #bind(acc, #allocate_val(#block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).Z ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )), $.T)) ;
    #bind(i, #allocate_val($.ONE, $.T)) ;
    loop_p := ^(
        cond := #block(^( a := $#parent(#this).i ; b := $#parent(#this).cnt ; #break(#evaluate($#parent(#this).env.iops.lt_i64)) )) ;
        #branch($.cond, ^(
            #drop(.cond) ;
            rhs := #block(^( arena := $#parent(#this).arena ; node := $#parent(#this).node ; index := $#parent(#this).i ; #break(#evaluate($#parent(#this).caps.syntax.cst_eval_child)) )) ;
            nxt := #block(^( arena := $#parent(#this).arena ; kind := resume ; 0 := $#parent(#this).acc ; 1 := $#parent(#this).rhs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
            #write(.acc, $.nxt) ;
            #drop(.rhs) ; #drop(.nxt) ;
            next_i := #block(^( a := $#parent(#this).i ; b := $#parent(#this).ONE ; #break(#evaluate($#parent(#this).env.iops.add_i64)) )) ;
            #write(.i, $.next_i) ;
            #drop(.next_i) ;
            #evaluate($.loop_p)
        ), ^(
            #drop(.cond) ;
            $.acc
        ))
    ) ;
    #evaluate($.loop_p)
) ;
h_coro := #evaluate($.wrap_h_with) ; #drop(.raw_h) ;

coro_body := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_ws ; 1 := $#parent(#this).lit_at ; 2 := $#parent(#this).ref_ws ; 3 := $#parent(#this).ref_deref_p ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
coro_tail := #block(^( fe := $#parent(#this).fe ; body := $#parent(#this).coro_body ; min := $#parent(#this).Z ; max := $#parent(#this).MAX ; #break(#evaluate($#parent(#this).c_syn.repeat)) )) ;
e_coro := #block(^( fe := $#parent(#this).fe ; 0 := $#parent(#this).ref_deref_p ; 1 := $#parent(#this).coro_tail ; #break(#evaluate($#parent(#this).c_syn.seq)) )) ;
#block(^( fe := $#parent(#this).fe ; name := CoroExpr ; expr := $#parent(#this).e_coro ; hidden := $#parent(#this).F ; handler := $#parent(#this).h_coro ; #evaluate($#parent(#this).c_syn.set_rule) )) ;
ref_coro := #block(^( fe := $#parent(#this).fe ; name := CoroExpr ; #break(#evaluate($#parent(#this).c_syn.ref)) )) ;

