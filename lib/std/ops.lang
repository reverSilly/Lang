! ============================================================================ !
! lib/std/ops.lang — Type-Dispatched Layer 1 Operators (depends on types.lang) !
!                                                                              !
! Written in Layer 1 (with types + literals active).                           !
! Installs operator precedence ladder into `OpExpr`:                           !
!   P7: UnaryExpr = ("+" / "-" / "~") _ UnaryExpr / Prefix                     !
!   P8: MulExpr   = UnaryExpr (_ "*" _ UnaryExpr)*                             !
!   P9: AddExpr   = MulExpr (_ ("+" / "-") _ MulExpr)*                         !
!   P11/12: CmpExpr = AddExpr (_ ("==" / "<") _ AddExpr)*                      !
!   OpExpr = CmpExpr                                                           !
!                                                                              !
! All runtime dispatch uses ZST-tagged Shapes from `types.lang`:               !
!   - `~` on Boolean -> logical NOT (Boolean); on i8..i64 / u8..u64 -> bit_not !
!   - `+` / `-` unary on i64 -> identity / 0 - x (i64)                         !
!   - `*` / `+` / `-` binary on i64 -> i64                                     !
!   - `<` on i64 (or raw8) -> Boolean                                          !
!   - `==` on matching Shapes (i64, u64, u8, i8, Boolean, Symbol, Shape,       !
!     raw8, raw1) -> Boolean                                                   !
! ============================================================================ !

! --- Build pure stageable op_iops table (zero caps / zero NativeProto) --- !
p_not_1 := #block(^( width := $#parent(#this).W1 ; src := x ; #break(#evaluate($#parent(#this).caps.intrinsics.bit_not)) )) ;
p_not_2 := #block(^( width := $#parent(#this).W2 ; src := x ; #break(#evaluate($#parent(#this).caps.intrinsics.bit_not)) )) ;
p_not_4 := #block(^( width := $#parent(#this).W4 ; src := x ; #break(#evaluate($#parent(#this).caps.intrinsics.bit_not)) )) ;
p_not_8 := #block(^( width := $#parent(#this).W8 ; src := x ; #break(#evaluate($#parent(#this).caps.intrinsics.bit_not)) )) ;

op_iops := {
    add_i64      := $#parent(#this).p_add_i64 ;
    sub_i64      := $#parent(#this).p_sub_i64 ;
    mul_i64      := $#parent(#this).p_mul_i64 ;
    lt_i64       := $#parent(#this).p_lt_i64 ;
    eq_i64       := $#parent(#this).p_eq_i64 ;
    eq_sym       := $#parent(#this).p_eq_sym ;
    eq_raw1      := $#parent(#this).p_eq_raw1 ;
    eq_shape     := $#parent(#this).p_eq_shape ;
    not_1        := $#parent(#this).p_not_1 ;
    not_2        := $#parent(#this).p_not_2 ;
    not_4        := $#parent(#this).p_not_4 ;
    not_8        := $#parent(#this).p_not_8 ;
    zero_raw1    := $#parent(#this).F ;
    zero_raw8    := $#parent(#this).Z ;
    symbol_shape := $#parent(#this).c_con.symbol_shape ;
    shape_meta   := $#parent(#this).c_con.shape_meta ;
    types        := $#parent(#this).types
} ;

! Helper: wrap runtime op prototype with `op_iops` bound as `iops` !
wrap_std_op := ^(
    #block(^(
        p_iops := $#parent(#this).op_iops ;
        arena  := $#parent(#this).arena ;
        p_raw  := $#parent(#this).op_raw ;
        val := $#parent(#this).F ; n_f := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        sym := iops ; w_i := #evaluate($#parent(#this).c_ast.word) ; #drop(.sym) ;
        val := $.p_iops ; n_i := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := allocate_val ; \0 := $.n_i ; \1 := $.n_f ; t_ai := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        kind := bind ; \0 := $.w_i ; \1 := $.t_ai ; s2 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ; #drop(.\1) ;
        val := $.p_raw ; n_r := #evaluate($#parent(#this).c_ast.value) ; #drop(.val) ;
        kind := evaluate ; \0 := $.n_r ; s3 := #evaluate($#parent(#this).c_ast.builtin) ; #drop(.kind) ; #drop(.\0) ;
        \0 := $.s2 ; \1 := $.s3 ; ast := #evaluate($#parent(#this).c_ast.seq) ; #drop(.\0) ; #drop(.\1) ;
        #break(#evaluate($#parent(#this).c_ast.to_proto))
    ))
) ;

! --- Runtime Shape-dispatched Unary Operators (P7: +, -, ~) --- !
op_raw := ^(
    is_i64 := #block(^( a := #shape($#parent(#this).x) ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    $.x if $.is_i64 else #break(type_error_pos)
) ;
op_pos := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    is_i64 := #block(^( a := #shape($#parent(#this).x) ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        r := #block(^( a := $#parent(#this).iops.zero_raw8 ; b := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.sub_i64)) )) ;
        { __raw := $#parent(#this).r ; __i64_tag := {} }
    ) if $.is_i64 else #break(type_error_neg)
) ;
op_neg := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    sx := #shape($.x) ;
    is_bool := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.Boolean ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        r := #block(^( a := $#parent(#this).x.__raw ; b := $#parent(#this).iops.zero_raw1 ; #break(#evaluate($#parent(#this).iops.eq_raw1)) )) ;
        { __raw := $#parent(#this).r ; __boolean_tag := {} }
    ) if $.is_bool else (
        is_i64 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_8)) )) ;
            { __raw := $#parent(#this).r ; __i64_tag := {} }
        ) if $.is_i64 else (
            is_u64 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.u64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
            (
                r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_8)) )) ;
                { __raw := $#parent(#this).r ; __u64_tag := {} }
            ) if $.is_u64 else (
                is_i32 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.i32 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                (
                    r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_4)) )) ;
                    { __raw := $#parent(#this).r ; __i32_tag := {} }
                ) if $.is_i32 else (
                    is_u32 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.u32 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                    (
                        r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_4)) )) ;
                        { __raw := $#parent(#this).r ; __u32_tag := {} }
                    ) if $.is_u32 else (
                        is_i16 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.i16 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                        (
                            r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_2)) )) ;
                            { __raw := $#parent(#this).r ; __i16_tag := {} }
                        ) if $.is_i16 else (
                            is_u16 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.u16 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                            (
                                r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_2)) )) ;
                                { __raw := $#parent(#this).r ; __u16_tag := {} }
                            ) if $.is_u16 else (
                                is_i8 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.i8 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                                (
                                    r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_1)) )) ;
                                    { __raw := $#parent(#this).r ; __i8_tag := {} }
                                ) if $.is_i8 else (
                                    is_u8 := #block(^( a := $#parent(#this).sx ; b := $#parent(#this).iops.types.u8 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                                    (
                                        r := #block(^( x := $#parent(#this).x.__raw ; #break(#evaluate($#parent(#this).iops.not_1)) )) ;
                                        { __raw := $#parent(#this).r ; __u8_tag := {} }
                                    ) if $.is_u8 else #break(type_error_not)
                                )
                            )
                        )
                    )
                )
            )
        )
    )
) ;
op_not := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

! --- Runtime Shape-dispatched Binary Operators (*, +, -, <, ==) --- !
op_raw := ^(
    same := #block(^( a := #shape($#parent(#this).a) ; b := #shape($#parent(#this).b) ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        is_i64 := #block(^( a := #shape($#parent(#this).a) ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.add_i64)) )) ;
            { __raw := $#parent(#this).r ; __i64_tag := {} }
        ) if $.is_i64 else #break(type_error_add)
    ) if $.same else #break(type_error_add)
) ;
op_add := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    same := #block(^( a := #shape($#parent(#this).a) ; b := #shape($#parent(#this).b) ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        is_i64 := #block(^( a := #shape($#parent(#this).a) ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.sub_i64)) )) ;
            { __raw := $#parent(#this).r ; __i64_tag := {} }
        ) if $.is_i64 else #break(type_error_sub)
    ) if $.same else #break(type_error_sub)
) ;
op_sub := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    same := #block(^( a := #shape($#parent(#this).a) ; b := #shape($#parent(#this).b) ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        is_i64 := #block(^( a := #shape($#parent(#this).a) ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.mul_i64)) )) ;
            { __raw := $#parent(#this).r ; __i64_tag := {} }
        ) if $.is_i64 else #break(type_error_mul)
    ) if $.same else #break(type_error_mul)
) ;
op_mul := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    same := #block(^( a := #shape($#parent(#this).a) ; b := #shape($#parent(#this).b) ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        sa := #shape($.a) ;
        is_i64 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.lt_i64)) )) ;
            { __raw := $#parent(#this).r ; __boolean_tag := {} }
        ) if $.is_i64 else (
            is_r8 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.raw8_shape ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
            (
                r := #block(^( a := $#parent(#this).a ; b := $#parent(#this).b ; #break(#evaluate($#parent(#this).iops.lt_i64)) )) ;
                { __raw := $#parent(#this).r ; __boolean_tag := {} }
            ) if $.is_r8 else #break(type_error_lt)
        )
    ) if $.same else #break(type_error_lt)
) ;
op_lt := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

op_raw := ^(
    same := #block(^( a := #shape($#parent(#this).a) ; b := #shape($#parent(#this).b) ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
    (
        sa := #shape($.a) ;
        is_i64 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.i64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
        (
            r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.eq_i64)) )) ;
            { __raw := $#parent(#this).r ; __boolean_tag := {} }
        ) if $.is_i64 else (
            is_bool := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.Boolean ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
            (
                r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.eq_raw1)) )) ;
                { __raw := $#parent(#this).r ; __boolean_tag := {} }
            ) if $.is_bool else (
                is_sym := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.symbol_shape ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                (
                    r := #block(^( a := $#parent(#this).a ; b := $#parent(#this).b ; #break(#evaluate($#parent(#this).iops.eq_sym)) )) ;
                    { __raw := $#parent(#this).r ; __boolean_tag := {} }
                ) if $.is_sym else (
                    is_sh := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.shape_meta ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                    (
                        r := #block(^( a := $#parent(#this).a ; b := $#parent(#this).b ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                        { __raw := $#parent(#this).r ; __boolean_tag := {} }
                    ) if $.is_sh else (
                        is_r8 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.raw8_shape ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                        (
                            r := #block(^( a := $#parent(#this).a ; b := $#parent(#this).b ; #break(#evaluate($#parent(#this).iops.eq_i64)) )) ;
                            { __raw := $#parent(#this).r ; __boolean_tag := {} }
                        ) if $.is_r8 else (
                            is_r1 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.raw1_shape ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                            (
                                r := #block(^( a := $#parent(#this).a ; b := $#parent(#this).b ; #break(#evaluate($#parent(#this).iops.eq_raw1)) )) ;
                                { __raw := $#parent(#this).r ; __boolean_tag := {} }
                            ) if $.is_r1 else (
                                is_u8 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.u8 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                                (
                                    r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.eq_raw1)) )) ;
                                    { __raw := $#parent(#this).r ; __boolean_tag := {} }
                                ) if $.is_u8 else (
                                    is_u64 := #block(^( a := $#parent(#this).sa ; b := $#parent(#this).iops.types.u64 ; #break(#evaluate($#parent(#this).iops.eq_shape)) )) ;
                                    (
                                        r := #block(^( a := $#parent(#this).a.__raw ; b := $#parent(#this).b.__raw ; #break(#evaluate($#parent(#this).iops.eq_i64)) )) ;
                                        { __raw := $#parent(#this).r ; __boolean_tag := {} }
                                    ) if $.is_u64 else #break(type_error_eq)
                                )
                            )
                        )
                    )
                )
            )
        )
    ) if $.same else #break(type_error_eq)
) ;
op_eq := #evaluate($.wrap_std_op) ; #drop(.op_raw) ;

! --- AST Builders for Unary & Binary Operators --- !
build_unop_ast := ^(
    #block(^(
        caps   := $#parent(#this).caps ;
        arena  := $#parent(#this).arena ;
        u_sym  := $#parent(#this).u_sym ;
        u_arg  := $#parent(#this).u_arg ;
        u_op   := $#parent(#this).u_op ;
        F      := $.caps.constants.\false ;
        n_F    := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        a_this := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        a_par  := #block(^( arena := $#parent(#this).arena ; kind := parent ; \0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        w_ua   := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).u_sym ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_x    := #block(^( arena := $#parent(#this).arena ; sym := x ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;

        al_arg := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).u_arg ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s_bind := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_ua ; \1 := $#parent(#this).al_arg ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        p_pua  := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_ua ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_pua  := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_pua ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        dr_pua := #block(^( arena := $#parent(#this).arena ; kind := drop ; \0 := $#parent(#this).p_pua ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_x   := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_pua ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_x    := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_x ; \1 := $#parent(#this).al_x ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        v_op   := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).u_op ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        ev_op  := #block(^( arena := $#parent(#this).arena ; kind := evaluate ; \0 := $#parent(#this).v_op ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        brk_op := #block(^( arena := $#parent(#this).arena ; kind := break ; \0 := $#parent(#this).ev_op ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        b_seq  := #block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).b_x ; \1 := $#parent(#this).dr_pua ; \2 := $#parent(#this).brk_op ; #break(#evaluate($#parent(#this).caps.ast.seq)) )) ;
        v_pr   := #block(^( arena := $#parent(#this).arena ; ast := $#parent(#this).b_seq ; #break(#evaluate($#parent(#this).caps.ast.proto)) )) ;
        blk_op := #block(^( arena := $#parent(#this).arena ; kind := block ; \0 := $#parent(#this).v_pr ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        #break(#block(^( arena := $#parent(#this).arena ; \0 := $#parent(#this).s_bind ; \1 := $#parent(#this).blk_op ; #break(#evaluate($#parent(#this).caps.ast.seq)) )))
    ))
) ;

build_binop_ast := ^(
    #block(^(
        caps    := $#parent(#this).caps ;
        arena   := $#parent(#this).arena ;
        b_sym_a := $#parent(#this).b_sym_a ;
        b_lhs   := $#parent(#this).b_lhs ;
        b_rhs   := $#parent(#this).b_rhs ;
        b_op    := $#parent(#this).b_op ;
        F       := $.caps.constants.\false ;
        n_F     := #block(^( arena := $#parent(#this).arena ; val := $#parent(#this).F ; #break(#evaluate($#parent(#this).caps.ast.value)) )) ;
        a_this  := #block(^( arena := $#parent(#this).arena ; kind := this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        a_par   := #block(^( arena := $#parent(#this).arena ; kind := parent ; \0 := $#parent(#this).a_this ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        w_oa    := #block(^( arena := $#parent(#this).arena ; sym := $#parent(#this).b_sym_a ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_ob    := #block(^( arena := $#parent(#this).arena ; sym := __op_b ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_a     := #block(^( arena := $#parent(#this).arena ; sym := a ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;
        w_b     := #block(^( arena := $#parent(#this).arena ; sym := b ; #break(#evaluate($#parent(#this).caps.ast.word)) )) ;

        al_lhs  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).b_lhs ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s_bind1 := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_oa ; \1 := $#parent(#this).al_lhs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_rhs  := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).b_rhs ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        s_bind2 := #block(^( arena := $#parent(#this).arena ; kind := bind ; \0 := $#parent(#this).w_ob ; \1 := $#parent(#this).al_rhs ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;

        p_pa    := #block(^( arena := $#parent(#this).arena ; kind := field ; \0 := $#parent(#this).a_par ; \1 := $#parent(#this).w_oa ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        d_pa    := #block(^( arena := $#parent(#this).arena ; kind := deref ; \0 := $#parent(#this).p_pa ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
        al_a    := #block(^( arena := $#parent(#this).arena ; kind := allocate_val ; \0 := $#parent(#this).d_pa ; \1 := $#parent(#this).n_F ; #break(#evaluate($#parent(#this).caps.ast.builtin)) )) ;
