! ============================================================================ !
! tests/test_layer1.lang — Pure Layer 1 Target Program Test Suite              !
! Executed via capabilities.backends.interpreter.run in a brand-new isolated   !
! RuntimeContext + Evaluator (no #parent, zero capabilities, zero FFI).        !
! ============================================================================ !

_T := true ; T_raw := $._T.__raw ;
_F := false ; F_raw := $._F.__raw ;
_0 := 0 ; R0 := $._0.__raw ;
_5 := 5 ; R5 := $._5.__raw ;
_12 := 12 ; R12 := $._12.__raw ;

assert_true := ^(
    ok if $.cond else #deref(#field(#this, __assertion_failed__))
) ;

! 1. Literals: i64, Boolean (ZST-marker), pure RawBytes string !
a := 42 ;
s := "hello_layer1" ;
cond := $.a == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
s_sh := #shape($.s) ; cond := $.s_sh.size == $.R12 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 1b. ZST-marker Boolean & Unary Prefix Operators (+, -, ~) !
cond := true == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~true == false ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~false == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~~true == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := +42 == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := --42 == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -42 + 42 == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -(2 + 3) == -5 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -2 * -3 == 6 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~0 == -1 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~(-1) == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~42 == -43 ; #evaluate($.assert_true) ; #drop(.cond) ;

! u8 bitwise ~ (0x01 -> 0xFE not_= 0x00) vs Boolean logical ~ (true -> false == 0x00) !
u8_one := { __raw := $#parent(#this).T_raw ; __u8_tag := {} } ;
u8_not := ~$.u8_one ;
cond := ~~$.u8_one == $.u8_one ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~($.u8_not.__raw == $.F_raw) ; #evaluate($.assert_true) ; #drop(.cond) ;

! 2. Smart `:=` dispatcher & location-owned mutability !
x := #allocate_val(10, $.T_raw) ;
.x = 25 ;
p := .x ;
cond := $.x == 25 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $$.p == 25 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 3. Precedence, left-associativity & arbitrary nesting of Shape-dispatched ops !
r1 := (1 + 2) * (3 + 4) ;
cond := $.r1 == 21 ; #evaluate($.assert_true) ; #drop(.cond) ;

r2 := 2 + 3 * 4 ;
cond := $.r2 == 14 ; #evaluate($.assert_true) ; #drop(.cond) ;

r3 := 10 - 3 - 2 ;
cond := $.r3 == 5 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Symbol & Shape equality via `==` dispatcher !
cond := foo == foo ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := #shape(42) == #shape(0) ; #evaluate($.assert_true) ; #drop(.cond) ;

! 4. English-order suffix `if/else` !
v_if1 := 100 if ($.x == 25) else 0 ;
v_if2 := 100 if ($.x < 10) else 200 ;
cond := $.v_if1 == 100 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.v_if2 == 200 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 5. English-order suffix `while`: sum 1..10 == 55 !
sum := #allocate_val(0, $.T_raw) ;
idx := #allocate_val(1, $.T_raw) ;
(.sum = $.sum + $.idx ; .idx = $.idx + 1) while ($.idx < 11) ;
cond := $.sum == 55 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 6. Closed struct blocks `{}` and `{ expr }` !
empty_u := {} ;
pt := { px := 10 ; py := 32 } ;
cond := $.pt.px + $.pt.py == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 6b. Multi-level ancestor block access via #parent(#parent(#this)) !
nested_gp := {
    outer_v := 99 ;
    mid := {
        inner := {
            #break($#parent(#parent(#this)).outer_v)
        } ;
        #break($.inner)
    } ;
    #break($.mid)
} ;
cond := $.nested_gp == 99 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 7. Coroutines with `@` (`#resume`) !
worker := #new(^(
    v1 := $#in ;
    #caller @ ($.v1 * 2) ;
    v2 := $#in ;
    #break($.v2 + 100)
)) ;
$.worker @ 10 ;
out1 := $#in ;
cond := $.out1 == 20 ; #evaluate($.assert_true) ; #drop(.cond) ;

$.worker @ 5 ;
out2 := $#in ;
cond := $.out2 == 105 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 8. Dynamic Symbol as value: :=, .Atom, p.Atom, Prefix LHS =, and \0 escape !
sym := another ;
($.sym) := 1 ;
cond := $.another == 1 ; #evaluate($.assert_true) ; #drop(.cond) ;

sym2 := dyn_var ;
$.sym2 := 7 ;
cond := $.dyn_var == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.($.sym2) == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;

f_key := py ;
cond := $.pt.($.f_key) == 32 ; #evaluate($.assert_true) ; #drop(.cond) ;

$.p = 30 ;
cond := $.x == 30 ; #evaluate($.assert_true) ; #drop(.cond) ;

\0 := 77 ;
cond := $.\0 == 77 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 9. BytesLit Escaped support (" and \) and empty BytesLit !
eb := "" ;
eb_sh := #shape($.eb) ;
cond := $.eb_sh.size == $.R0 ; #evaluate($.assert_true) ; #drop(.cond) ;

esc_b := "a\"b\\c" ;
esc_sh := #shape($.esc_b) ;
cond := $.esc_sh.size == $.R5 ; #evaluate($.assert_true) ; #drop(.cond) ;

layer1_tests_passed
