! 8c. Composite struct by value: div(17, 5) -> { quot = 3, rem = 2 } !
i32_17 := #block(^( x := 17 ; #break(#evaluate($#parent.trunc_8_4)) )) ;
i32_5  := #block(^( x := 5  ; #break(#evaluate($#parent.trunc_8_4)) )) ;
d_res  := #block(^( 0 := $#parent.i32_17 ; 1 := $#parent.i32_5 ; #break(#evaluate($#parent.libc.div)) )) ;
d_quot := #block(^( x := $#parent.d_res.quot ; #break(#evaluate($#parent.sext_4_8)) )) ;
