! ============================================================================ !
! tests/test_layer1.lang — Pure Layer 1 Target Program Test Suite              !
! Executed via capabilities.backends.interpreter.run in a brand-new isolated   !
! RuntimeContext + Evaluator (no #parent, zero capabilities, zero FFI).        !
! ============================================================================ !

_T := true ; T_raw := $._T.__raw ;
_F := false ; F_raw := $._F.__raw ;
_0 := 0 ; R0 := $._0.__raw ;
_5 := 5 ; R5 := $._5.__raw ;
_12 := 12 ; R12 := $._12.__raw ;

assert_true := ^(
    ok if $.cond else #deref(#field(#this, __assertion_failed__))
) ;

! 1. Literals: i64, Boolean (ZST-marker), pure RawBytes string !
a := 42 ;
s := "hello_layer1" ;
cond := $.a == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
s_sh := #shape($.s) ; cond := $(($.s_sh).size) == $.R12 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 1b. ZST-marker Boolean & Unary Prefix Operators (+, -, ~) !
cond := true == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~true == false ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~false == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~~true == true ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := +42 == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := --42 == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -42 + 42 == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -(2 + 3) == -5 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := -2 * -3 == 6 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~0 == -1 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~(-1) == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~42 == -43 ; #evaluate($.assert_true) ; #drop(.cond) ;

! u8 bitwise ~ (0x01 -> 0xFE not_= 0x00) vs Boolean logical ~ (true -> false == 0x00) !
u8_one := { __raw := $#parent(#this).T_raw ; __u8_tag := {} } ;
u8_not := ~$.u8_one ;
cond := ~~$.u8_one == $.u8_one ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := ~($.u8_not.__raw == $.F_raw) ; #evaluate($.assert_true) ; #drop(.cond) ;

! 2. Smart `:=` dispatcher & location-owned mutability !
x := #allocate_val(10, $.T_raw) ;
.x = 25 ;
p := .x ;
cond := $.x == 25 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $$.p == 25 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 3. Precedence, left-associativity & arbitrary nesting of Shape-dispatched ops !
r1 := (1 + 2) * (3 + 4) ;
cond := $.r1 == 21 ; #evaluate($.assert_true) ; #drop(.cond) ;

r2 := 2 + 3 * 4 ;
cond := $.r2 == 14 ; #evaluate($.assert_true) ; #drop(.cond) ;

r3 := 10 - 3 - 2 ;
cond := $.r3 == 5 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Symbol & Shape equality via `==` dispatcher !
cond := foo == foo ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := #shape(42) == #shape(0) ; #evaluate($.assert_true) ; #drop(.cond) ;

! 4. English-order suffix `if/else` !
v_if1 := 100 if ($.x == 25) else 0 ;
v_if2 := 100 if ($.x < 10) else 200 ;
cond := $.v_if1 == 100 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.v_if2 == 200 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 5. English-order suffix `while`: sum 1..10 == 55 !
sum := #allocate_val(0, $.T_raw) ;
idx := #allocate_val(1, $.T_raw) ;
(.sum = $.sum + $.idx ; .idx = $.idx + 1) while ($.idx < 11) ;
cond := $.sum == 55 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 6. Closed struct blocks `{}` and `{ expr }` !
empty_u := {} ;
pt := { px := 10 ; py := 32 } ;
cond := $.pt.px + $.pt.py == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 6b. Multi-level ancestor block access via #parent(#parent(#this)) !
nested_gp := {
    outer_v := 99 ;
    mid := {
        inner := {
            #break($#parent(#parent(#this)).outer_v)
        } ;
        #break($.inner)
    } ;
    #break($.mid)
} ;
cond := $.nested_gp == 99 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 7. Coroutines with `@` (`#resume`) !
worker := #new(^(
    v1 := $#in ;
    #caller @ ($.v1 * 2) ;
    v2 := $#in ;
    #break($.v2 + 100)
)) ;
$.worker @ 10 ;
out1 := $#in ;
cond := $.out1 == 20 ; #evaluate($.assert_true) ; #drop(.cond) ;

$.worker @ 5 ;
out2 := $#in ;
cond := $.out2 == 105 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 8. Dynamic Symbol as value: :=, .Atom, p.Atom, Prefix LHS =, and \0 escape !
sym := another ;
($.sym) := 1 ;
cond := $.another == 1 ; #evaluate($.assert_true) ; #drop(.cond) ;

sym2 := dyn_var ;
$.sym2 := 7 ;
cond := $.dyn_var == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.($.sym2) == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;

f_key := py ;
cond := $.pt.($.f_key) == 32 ; #evaluate($.assert_true) ; #drop(.cond) ;

$.p = 30 ;
cond := $.x == 30 ; #evaluate($.assert_true) ; #drop(.cond) ;

\0 := 77 ;
cond := $.\0 == 77 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 9. BytesLit Escaped support (" and \) and empty BytesLit !
eb := "" ;
eb_sh := #shape($.eb) ;
cond := $(($.eb_sh).size) == $.R0 ; #evaluate($.assert_true) ; #drop(.cond) ;

esc_b := "a\"b\\c" ;
esc_sh := #shape($.esc_b) ;
cond := $(($.esc_sh).size) == $.R5 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 10. Lexical upward `.sym` lookup, `#this.sym` single-frame, & juxtaposition calls !
up_val := 77 ;
up_res := {
    mid := {
        inner := {
            #break($.up_val)
        } ;
        #break($.inner)
    } ;
    #break($.mid)
} ;
cond := $.up_res == 77 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Shadowing `up_val := $.up_val + 1` reads outer, binds inner !
sh_res := {
    up_val := $.up_val + 1 ;
    #break($.up_val)
} ;
cond := $.sh_res == 78 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.up_val == 77 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Mutating outer mutable slot from nested block via `.sym` !
outer_mut := #allocate_val(10, $.T_raw) ;
_ := {
    .outer_mut = $.outer_mut + 5 ;
    #break(ok)
} ;
cond := $.outer_mut == 15 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Explicit `#this.sym` remains strictly single-frame (does not walk up) !
single_check := {
    p_local := #this.up_val ;
    #break($.p_local.addr == $.R0)
} ;
cond := $.single_check ; #evaluate($.assert_true) ; #drop(.cond) ;

! Juxtaposition single-arg calls: `$.f $.x`, `$.f($.x)`, `$.f {}`, nested, curried !
inc := {
    __env  := {} ;
    __code := ^( $.__arg + 1 )
} ;
cond := $($.inc 41) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.inc(41)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.inc (20 + 21)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.inc $($.inc 40)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.inc($($.inc(40)))) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

get_zero := {
    __env  := {} ;
    __code := ^( 0 )
} ;
cond := $($.get_zero {}) == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Closure with `__env` + curried juxtaposition `$.make_adder 10 32 == 42` !
make_adder := {
    __env  := {} ;
    __code := ^(
        base := $.__arg ;
        {
            __env  := { k := $.base } ;
            __code := ^( $.k + $.__arg )
        }
    )
} ;
cond := $($.make_adder 10 32) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Lexical scope barrier: callee MUST NOT see caller's local `caller_secret` !
caller_secret := 999 ;
check_iso := {
    __env  := {} ;
    __code := ^(
        p_sec := .caller_secret ;
        $.p_sec.addr == $.__arg
    )
} ;
cond := $($.check_iso $.R0) ; #evaluate($.assert_true) ; #drop(.cond) ;

! 11. Function definition `param -> body` (strictly single-arg) & pure-stdlib closure !
inc2 := x -> $.x + 1 ;
cond := $($.inc2 41) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.inc2(41)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Ignored single-arg `_ -> ...` (binds `{}` to `_`, symmetric with 1-arg call) !
get_k := _ -> 99 ;
cond := $($.get_k {}) == 99 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Right-assoc body allows `if/else` without outer parens !
abs_fn := x -> -$.x if $.x < 0 else $.x ;
cond := $($.abs_fn (-7)) == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.abs_fn 7) == 7 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Struct argument & early `#break` return !
add_pt := p -> $.p.a + $.p.b ;
cond := $($.add_pt { a := 10 ; b := 32 }) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

clamp_pos := x -> ( #break(0) if $.x < 0 else ok ; $.x ) ;
cond := $($.clamp_pos (-5)) == 0 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.clamp_pos 12) == 12 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Zero-new-syntax explicit closure via ordinary stdlib helper `with_env` !
with_env := spec -> { __env := $.spec.env ; __code := $.spec.fn.__code } ;
adder10 := $.with_env { env := { k := 10 } ; fn := (x -> $.k + $.x) } ;
cond := $($.adder10 32) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Curried closure using `param -> body` + `with_env` captured in `__env` !
make_adder2 := $.with_env {
    env := { with_env := $.with_env } ;
    fn  := (base -> $.with_env { env := { k := $.base } ; fn := (x -> $.k + $.x) })
} ;
cond := $($.make_adder2 10 32) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! --- 12. Pure Transparent Tuples (`a, b, c`, no trailing comma, zero matcher) --- !
t3 := 10, 20, 12 ;
cond := $.t3.\0 == 10 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.t3.\1 == 20 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.t3.\2 == 12 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.t3.\0 + $.t3.\1 + $.t3.\2 == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Exact Shape isomorphism with positional struct `{ \0 := ... ; \1 := ... }` !
s_tup := #shape($((1, 2))) ;
s_pos := #shape($({ \0 := 1 ; \1 := 2 })) ;
cond := $.s_tup == $.s_pos ; #evaluate($.assert_true) ; #drop(.cond) ;

! Nested tuples & arithmetic elements !
tn := (1 + 2, 3 * 4), (5, 6 + 7) ;
cond := $.tn.\0.\0 == 3  ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.tn.\0.\1 == 12 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.tn.\1.\0 == 5  ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.tn.\1.\1 == 13 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Multi-arg call via single-arg juxtaposition + tuple `(a, b)` !
add_pair := p -> $.p.\0 + $.p.\1 ;
cond := $($.add_pair(15, 27)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $($.add_pair (15, 27)) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Lambda returning a bare tuple without extra parens !
dup_pair := x -> $.x, $.x * 2 ;
dp := $.dup_pair 14 ;
cond := $.dp.\0 == 14 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.dp.\1 == 28 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Tuple inside Core builtin via grouping `(a, b)` !
bf := false ; t_box := #allocate_val($((7, 8)), $.bf.__raw) ;
cond := $.t_box.\0 + $.t_box.\1 == 15 ; #evaluate($.assert_true) ; #drop(.cond) ;


! --- 13. `#block(p, is_mut)` -> parent-frame unbound Pointer, direct field access & `box(val)` --- !
cond := $({ px := 10 ; py := 32 }.px) == 10 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $((10, 20, 12).\2) == 12 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Ordinary stdlib `box(val)` function: returns unbound Pointer to val in caller frame !
box := v -> $.v ;
cond := $(($.box (15, 27)).\0) + $(($.box (15, 27)).\1) == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

! Explicit mutable `#block(p, true)` slot can be mutated directly !
m_slot := #block(^( #break(10) ), $.T_raw) ;
.m_slot = 42 ;
cond := $.m_slot == 42 ; #evaluate($.assert_true) ; #drop(.cond) ;

layer1_tests_passed
