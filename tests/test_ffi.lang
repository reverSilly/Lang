! ============================================================================ !
! tests/test_ffi.lang — Standard C FFI Target Program Test Suite               !
! Executed via capabilities.backends.interpreter.run in a brand-new isolated   !
! RuntimeContext + Evaluator (zero capabilities). `libc`, `trunc_8_4`, and     !
! `sext_4_8` are lifted into the standalone Ast at compile time.               !
! ============================================================================ !

_F := false ; F_raw := $._F.__raw ;
_0 := 0 ; R0 := $._0.__raw ;
_2 := 2 ; R2 := $._2.__raw ;
_3 := 3 ; R3 := $._3.__raw ;
_5 := 5 ; R5 := $._5.__raw ;
_10 := 10 ; R10 := $._10.__raw ;
_12 := 12 ; R12 := $._12.__raw ;
_16 := 16 ; R16 := $._16.__raw ;
_17 := 17 ; R17 := $._17.__raw ;
_65 := 65 ; R65 := $._65.__raw ;
_12345 := 12345 ; R12345 := $._12345.__raw ;

assert_true := ^(
    ok if $.cond else #deref(#field(#this, __assertion_failed__))
) ;

! 1. Zero-FFI stack NUL-terminated C string: `{ body := $.s ; nul := $#parent(#this).F_raw }` -> strlen == 12 !
s := "hello_layer1" ;
cs_hello := { body := $#parent(#this).s ; nul := $#parent(#this).F_raw } ;
p_cs := .cs_hello ;
c_len := #block(^(
    \0 := $#parent(#this).p_cs.addr ;
    #break(#evaluate($#parent(#this).libc.strlen))
), $.F_raw) ;
cond := $.c_len == $.R12 ; #evaluate($.assert_true) ; #drop(.cond) ;

! 2. malloc + memset + memcpy + memcmp + free !
buf1 := #block(^( \0 := $#parent(#this).R16 ; #break(#evaluate($#parent(#this).libc.malloc)) ), $.F_raw) ;
buf2 := #block(^( \0 := $#parent(#this).R16 ; #break(#evaluate($#parent(#this).libc.malloc)) ), $.F_raw) ;
fill_ch := #block(^( x := $#parent(#this).R65 ; #break(#evaluate($#parent(#this).trunc_8_4)) ), $.F_raw) ;
#block(^( \0 := $#parent(#this).buf1 ; \1 := $#parent(#this).fill_ch ; \2 := $#parent(#this).R16 ; #break(#evaluate($#parent(#this).libc.memset)) ), $.F_raw) ;
#block(^( \0 := $#parent(#this).buf2 ; \1 := $#parent(#this).buf1 ; \2 := $#parent(#this).R16 ; #break(#evaluate($#parent(#this).libc.memcpy)) ), $.F_raw) ;
cmp_i32 := #block(^( \0 := $#parent(#this).buf1 ; \1 := $#parent(#this).buf2 ; \2 := $#parent(#this).R16 ; #break(#evaluate($#parent(#this).libc.memcmp)) ), $.F_raw) ;
cmp_i64 := #block(^( x := $#parent(#this).cmp_i32 ; #break(#evaluate($#parent(#this).sext_4_8)) ), $.F_raw) ;
cond := $.cmp_i64 == $.R0 ; #evaluate($.assert_true) ; #drop(.cond) ;
#block(^( \0 := $#parent(#this).buf1 ; #break(#evaluate($#parent(#this).libc.free)) ), $.F_raw) ;
#block(^( \0 := $#parent(#this).buf2 ; #break(#evaluate($#parent(#this).libc.free)) ), $.F_raw) ;

! 3. Composite struct by value: div(17, 5) -> { quot = 3, rem = 2 } !
i32_17 := #block(^( x := $#parent(#this).R17 ; #break(#evaluate($#parent(#this).trunc_8_4)) ), $.F_raw) ;
i32_5  := #block(^( x := $#parent(#this).R5  ; #break(#evaluate($#parent(#this).trunc_8_4)) ), $.F_raw) ;
d_res  := #block(^( \0 := $#parent(#this).i32_17 ; \1 := $#parent(#this).i32_5 ; #break(#evaluate($#parent(#this).libc.div)) ), $.F_raw) ;
d_quot := #block(^( x := $#parent(#this).d_res.quot ; #break(#evaluate($#parent(#this).sext_4_8)) ), $.F_raw) ;
d_rem  := #block(^( x := $#parent(#this).d_res.rem  ; #break(#evaluate($#parent(#this).sext_4_8)) ), $.F_raw) ;
cond := $.d_quot == $.R3 ; #evaluate($.assert_true) ; #drop(.cond) ;
cond := $.d_rem == $.R2  ; #evaluate($.assert_true) ; #drop(.cond) ;

! 4. strtoll("12345\0", NULL, 10) == 12345 !
s_num := "12345" ;
cs_num := { body := $#parent(#this).s_num ; nul := $#parent(#this).F_raw } ;
p_num := .cs_num ;
i32_10 := #block(^( x := $#parent(#this).R10 ; #break(#evaluate($#parent(#this).trunc_8_4)) ), $.F_raw) ;
parsed_num := #block(^(
    \0 := $#parent(#this).p_num.addr ;
    \1 := $#parent(#this).R0 ;
    \2 := $#parent(#this).i32_10 ;
    #break(#evaluate($#parent(#this).libc.strtoll))
), $.F_raw) ;
cond := $.parsed_num == $.R12345 ; #evaluate($.assert_true) ; #drop(.cond) ;

ffi_tests_passed
