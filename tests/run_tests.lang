#bind(a_bind_s48, #allocate_val(#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), builtin))), #deref(#field(#this, F)))) ;
#drop(#field(#this, kind)) ; #drop(#field(#this, 0)) ; #drop(#field(#this, 1)) ;

! Sequence prologue + test_ffi.lang body -> run in brand-new isolated RuntimeContext + Evaluator !
#bind(0, #allocate_val(#deref(#field(#this, a_bind_libc)), #deref(#field(#this, F)))) ;
#bind(1, #allocate_val(#deref(#field(#this, a_bind_t84)), #deref(#field(#this, F)))) ;
#bind(2, #allocate_val(#deref(#field(#this, a_bind_s48)), #deref(#field(#this, F)))) ;
#bind(3, #allocate_val(#deref(#field(#this, ffi_body_ast)), #deref(#field(#this, F)))) ;
#bind(ast, #allocate_val(#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), seq))), #deref(#field(#this, F)))) ;
#drop(#field(#this, 0)) ; #drop(#field(#this, 1)) ; #drop(#field(#this, 2)) ; #drop(#field(#this, 3)) ;

#bind(res_ffi, #allocate_val(#evaluate(#deref(#field(#field(#field(#field(#this, capabilities), backends), interpreter), run))), #deref(#field(#this, F)))) ;
#drop(#field(#this, ast)) ;

! 6. Release compiler arena & frontend (target FFI libraries auto-closed on target RuntimeContext teardown) !
#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), destroy_arena))) ;
#evaluate(#deref(#field(#field(#field(#this, capabilities), syntax), destroy_frontend))) ;

all_tests_passed
