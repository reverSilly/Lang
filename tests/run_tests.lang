#bind(a_w_s48, #allocate_val(#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), word))), #deref(#field(#this, F)))) ;
#drop(#field(#this, sym)) ;
#bind(val, #allocate_val(#deref(#field(#this, sext_4_8)), #deref(#field(#this, F)))) ;
#bind(a_v_s48, #allocate_val(#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), value))), #deref(#field(#this, F)))) ;
#drop(#field(#this, val)) ;
#bind(kind, #allocate_val(allocate_val, #deref(#field(#this, F)))) ;
#bind(0, #allocate_val(#deref(#field(#this, a_v_s48)), #deref(#field(#this, F)))) ;
#bind(1, #allocate_val(#deref(#field(#this, a_false)), #deref(#field(#this, F)))) ;
#bind(a_alloc_s48, #allocate_val(#evaluate(#deref(#field(#field(#field(#this, capabilities), ast), builtin))), #deref(#field(#this, F)))) ;
#drop(#field(#this, kind)) ; #drop(#field(#this, 0)) ; #drop(#field(#this, 1)) ;
